---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LANGS, type Lang, isLang, t } from "../../content/languages";
import { getPageBySlug, getSettings } from "../../vertical/cms/sheets";
import { ATLAS_ASSETS } from "../../vertical/content/assets";
import SunHero from "../../vertical/ui/SunHero.astro";
import HeroStage from "../../vertical/ui/HeroStage.astro";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const lang = langParam as Lang;

const p0 = Astro.url.pathname;
const p = p0.endsWith("/") ? p0 : `${p0}/`;
const [settings, pageSeo] = await Promise.all([getSettings(), getPageBySlug(p)]);

const projectName = (lang === "es" ? settings.project_name_es : settings.project_name_en) || "Atlas Residences";
const defaultDescription =
  (lang === "es" ? settings.tagline_es : settings.tagline_en) ||
  t(lang, "Premium residences in Barcelona.", "Residencias premium en Barcelona.");

const seoTitle = (lang === "es" ? pageSeo?.title_es : pageSeo?.title_en) || `${t(lang, "Home", "Inicio")} — ${projectName}`;
const seoDescription = (lang === "es" ? pageSeo?.description_es : pageSeo?.description_en) || defaultDescription;
const seoImage = pageSeo?.og_image || ATLAS_ASSETS.og.og01Home1200x630 || ATLAS_ASSETS.masterplan.mp01Wide16x9;
const seoNoindex = String(pageSeo?.noindex ?? "").toLowerCase() === "true";
const ogLocale = lang === "es" ? "es_ES" : "en_US";

// STABILITY LOCK (canonical): heroVariants mapping + SunHero wiring are canonical.
// Do NOT change variant keys or SunHero prop names/order lightly.
const heroVariants = {
  morning: ATLAS_ASSETS.hero.hr01Morning16x9,
  sunset: ATLAS_ASSETS.hero.hr02Sunset16x9,
  bluehour: ATLAS_ASSETS.hero.hr03Bluehour16x9,
  mobile: ATLAS_ASSETS.hero.hr04Mobile9x16,
} as const;

const defaultHeroVariant: keyof typeof heroVariants = "morning";
const heroImage = heroVariants[defaultHeroVariant] || ATLAS_ASSETS.hero.hr01Morning16x9;
const heroMobileImage = heroVariants.mobile;
---

<BaseLayout lang={lang} title={seoTitle}>
  <Fragment slot="head">
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={seoImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={seoImage} />
    {seoNoindex && <meta name="robots" content="noindex,nofollow" />}
  </Fragment>

  <section class="space-y-5 sm:space-y-6 md:space-y-8">
    {/* STABILITY LOCK (canonical): keep SunHero prop contract/order stable unless intentional redesign. */}
    <HeroStage>
      <SunHero
        morningImage={heroImage}
        bluehourImage={heroVariants.bluehour}
        sunsetImage={heroVariants.sunset}
        mobileImage={heroMobileImage}
        alt={t(lang, "Atlas Residences hero view", "Vista principal de Atlas Residences")}
        sliderLabel={t(lang, "Sun position", "Posición del sol")}
        morningLabel={t(lang, "Morning", "Mañana")}
        bluehourLabel={t(lang, "Blue hour", "Hora azul")}
        sunsetLabel={t(lang, "Sunset", "Atardecer")}
      />
    </HeroStage>

    <div class="max-w-3xl space-y-3 sm:space-y-4">
      <p class="text-[11px] uppercase tracking-[0.22em] text-black/60">{t(lang, "ATLAS RESIDENCES", "ATLAS RESIDENCES")}</p>
      <h1 class="text-3xl tracking-tight sm:text-4xl md:text-5xl">{t(lang, "Atlas Residences", "Atlas Residences")}</h1>
      <p class="max-w-2xl text-sm leading-relaxed text-black/75 sm:text-base">
        {t(
          lang,
          "Explore curated residences with live availability, masterplan hotspots, and detailed unit visuals.",
          "Explora residencias seleccionadas con disponibilidad en vivo, masterplan interactivo y detalles visuales por unidad.",
        )}
      </p>
    </div>

    <div class="cta-cluster cta-inline grid gap-2.5 sm:grid-cols-3 sm:gap-2.5 md:max-w-4xl md:items-stretch">
      <a class="cta-primary group flex min-h-12 items-center justify-between rounded-xl px-4 py-3 text-sm font-medium transition" href={`/${lang}/units/`}>
        {t(lang, "Explore available residences", "Explorar residencias disponibles")}
        <span class="cta-arrow text-xs transition">→</span>
      </a>
      <a class="cta-secondary group flex min-h-12 items-center justify-between rounded-xl px-4 py-3 text-sm font-medium transition" href={`/${lang}/masterplan/`}>
        {t(lang, "View masterplan", "Ver masterplan")}
        <span class="cta-arrow text-xs transition">→</span>
      </a>
      <a class="cta-tertiary group flex min-h-12 items-center justify-between rounded-xl px-4 py-3 text-sm font-medium transition" href={`/${lang}/contact/?source=home`}>
        {t(lang, "Talk with sales", "Hablar con ventas")}
        <span class="cta-arrow text-xs transition">→</span>
      </a>
    </div>

    <p class="pt-0.5 text-[11px] uppercase tracking-[0.12em] text-black/55 sm:text-xs">
      {t(lang, "Live inventory · Masterplan view · Request a viewing", "Inventario en vivo · Masterplan · Reservar visita")}
    </p>
  </section>
</BaseLayout>
