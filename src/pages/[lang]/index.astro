---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LANGS, type Lang, isLang, t } from "../../content/languages";
import { getPageBySlug, getSettings } from "../../vertical/cms/sheets";
import { ATLAS_ASSETS } from "../../vertical/content/assets";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const lang = langParam as Lang;

const p0 = Astro.url.pathname;
const p = p0.endsWith("/") ? p0 : `${p0}/`;
const [settings, pageSeo] = await Promise.all([getSettings(), getPageBySlug(p)]);

const projectName = (lang === "es" ? settings.project_name_es : settings.project_name_en) || "Atlas Residences";
const defaultDescription =
  (lang === "es" ? settings.tagline_es : settings.tagline_en) ||
  t(lang, "Premium residences in Barcelona.", "Residencias premium en Barcelona.");

const seoTitle = (lang === "es" ? pageSeo?.title_es : pageSeo?.title_en) || `${t(lang, "Home", "Inicio")} — ${projectName}`;
const seoDescription = (lang === "es" ? pageSeo?.description_es : pageSeo?.description_en) || defaultDescription;
const seoImage = pageSeo?.og_image || ATLAS_ASSETS.og.og01Home1200x630 || ATLAS_ASSETS.masterplan.mp01Wide16x9;
const seoNoindex = String(pageSeo?.noindex ?? "").toLowerCase() === "true";
const ogLocale = lang === "es" ? "es_ES" : "en_US";

const heroVariants = {
  morning: ATLAS_ASSETS.hero.hr01Morning16x9,
  sunset: ATLAS_ASSETS.hero.hr02Sunset16x9,
  bluehour: ATLAS_ASSETS.hero.hr03Bluehour16x9,
  mobile: ATLAS_ASSETS.hero.hr04Mobile9x16,
} as const;

const defaultHeroVariant: keyof typeof heroVariants = "morning";
const heroImage = heroVariants[defaultHeroVariant] || ATLAS_ASSETS.hero.hr01Morning16x9;
const heroMobileImage = heroVariants.mobile;
---

<BaseLayout lang={lang} title={seoTitle}>
  <Fragment slot="head">
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={seoImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={seoImage} />
    {seoNoindex && <meta name="robots" content="noindex,nofollow" />}
  </Fragment>

  <section class="space-y-6">
    {heroImage && (
      <div class="overflow-hidden rounded-2xl border bg-slate-100">
        <picture>
          {heroMobileImage && <source media="(max-width: 640px)" srcset={heroMobileImage} />}
          <img
            src={heroImage}
            alt={t(lang, "Atlas Residences hero view", "Vista principal de Atlas Residences")}
            class="h-full w-full object-cover"
            loading="eager"
          />
        </picture>
      </div>
    )}

    <div class="space-y-4">
      <p class="text-xs uppercase tracking-[0.2em] opacity-60">Atlas Residences</p>
      <h1 class="text-3xl tracking-tight sm:text-4xl">{t(lang, "Developer Demo Home", "Inicio demo de desarrollador")}</h1>
      <p class="max-w-3xl text-sm opacity-80 sm:text-base">
        {t(lang, "IA v1 skeleton for the new developer vertical.", "Esqueleto IA v1 para la nueva vertical de desarrollador.")}
      </p>
    </div>

    <div class="grid gap-3 sm:grid-cols-3">
      <a class="min-h-11 rounded-xl border px-4 py-3 text-sm transition hover:border-black/40" href={`/${lang}/units/`}>
        {t(lang, "Browse units", "Explorar unidades")}
      </a>
      <a class="min-h-11 rounded-xl border px-4 py-3 text-sm transition hover:border-black/40" href={`/${lang}/masterplan/`}>
        {t(lang, "View masterplan", "Ver masterplan")}
      </a>
      <a class="min-h-11 rounded-xl border px-4 py-3 text-sm transition hover:border-black/40" href={`/${lang}/contact/`}>
        {t(lang, "Contact sales", "Contactar ventas")}
      </a>
    </div>
  </section>
</BaseLayout>
