---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { LANGS, type Lang, isLang, t } from "../../../content/languages";
import { getPageBySlug, getSettings, getUnits, getUnitTypes } from "../../../vertical/cms/sheets";
import { ATLAS_ASSETS } from "../../../vertical/content/assets";

export async function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const lang = langParam as Lang;

const p0 = Astro.url.pathname;
const p = p0.endsWith("/") ? p0 : `${p0}/`;
const [settings, pageSeo] = await Promise.all([getSettings(), getPageBySlug(p)]);

const projectName = (lang === "es" ? settings.project_name_es : settings.project_name_en) || "Atlas Residences";
const defaultDescription =
  (lang === "es" ? settings.tagline_es : settings.tagline_en) ||
  t(lang, "Browse available units at Atlas Residences.", "Explora las unidades disponibles en Atlas Residences.");

const seoTitle = (lang === "es" ? pageSeo?.title_es : pageSeo?.title_en) || `${t(lang, "Units", "Unidades")} — ${projectName}`;
const seoDescription = (lang === "es" ? pageSeo?.description_es : pageSeo?.description_en) || defaultDescription;
const seoImage = pageSeo?.og_image || ATLAS_ASSETS.og.og02Units1200x630 || ATLAS_ASSETS.masterplan.mp01Wide16x9;
const seoNoindex = String(pageSeo?.noindex ?? "").toLowerCase() === "true";
const ogLocale = lang === "es" ? "es_ES" : "en_US";

const searchParams = Astro.url.searchParams;
const buildingParam = (searchParams.get("building") ?? "all").toLowerCase();
const initialBuilding = ["all", "a", "b"].includes(buildingParam) ? buildingParam : "all";

const units = (await getUnits()).sort((a, b) => Number(a.sort ?? 0) - Number(b.sort ?? 0));
const unitTypes = await getUnitTypes();
const unitTypeById = new Map(unitTypes.map((unitType) => [unitType.id, unitType]));

const statusClassMap: Record<string, string> = {
  available: "bg-emerald-50 text-emerald-800",
  reserved: "bg-amber-50 text-amber-800",
  sold: "bg-rose-50 text-rose-800",
  coming_soon: "bg-slate-100 text-slate-700",
};

const statusText = (status?: string) => {
  const normalized = String(status ?? "").toLowerCase();
  if (normalized === "available") return t(lang, "Available", "Disponible");
  if (normalized === "reserved") return t(lang, "Reserved", "Reservada");
  if (normalized === "sold") return t(lang, "Sold", "Vendida");
  if (normalized === "coming_soon") return t(lang, "Coming soon", "Próximamente");
  return t(lang, "Unknown", "Sin estado");
};

const buildUnitsHref = (unitId: string) => `/${lang}/units/${unitId}/`;
---

<BaseLayout lang={lang} title={seoTitle}>
  <Fragment slot="head">
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={seoImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={seoImage} />
    {seoNoindex && <meta name="robots" content="noindex,nofollow" />}
  </Fragment>

  <section class="space-y-4 sm:space-y-5">
    <header class="space-y-1.5">
      <h1 class="text-3xl tracking-tight">{t(lang, "Units", "Unidades")}</h1>
      <p id="units-summary" class="text-sm leading-relaxed opacity-80">{units.length} {t(lang, "units", "unidades")}</p>
      <p id="active-filters" class="text-sm opacity-70">{t(lang, "All filters", "Todos los filtros")}</p>
    </header>

    <div class="cta-cluster cta-inline flex flex-col gap-2 sm:flex-row sm:items-center">
      <a class="cta-primary ui-btn ui-btn--primary inline-flex items-center justify-center" href={`/${lang}/contact/?source=unit`}>
        {t(lang, "Book a viewing", "Reservar visita")}
      </a>
      <a class="cta-secondary ui-btn inline-flex items-center justify-center" href={`/${lang}/masterplan/`}>
        {t(lang, "Review masterplan", "Revisar plan maestro")}
      </a>
    </div>

    <div class="units-filters grid gap-3.5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-3.5" id="units-filters">
      <div class="space-y-1.5">
        <p class="text-sm font-medium tracking-wide opacity-80">{t(lang, "Building", "Bloque")}</p>
        <div class="flex flex-wrap gap-2" data-filter="building">
          <a data-value="all" class="ui-chip" href="#">{t(lang, "All", "Todos")}</a>
          <a data-value="a" class="ui-chip" href="#">A</a>
          <a data-value="b" class="ui-chip" href="#">B</a>
        </div>
      </div>
      <div class="space-y-1.5">
        <p class="text-sm font-medium tracking-wide opacity-80">{t(lang, "Beds", "Dormitorios")}</p>
        <div class="flex flex-wrap gap-2" data-filter="beds">
          <a data-value="all" class="ui-chip" href="#">{t(lang, "All", "Todos")}</a>
          <a data-value="1" class="ui-chip" href="#">1</a>
          <a data-value="2" class="ui-chip" href="#">2</a>
          <a data-value="3" class="ui-chip" href="#">3</a>
          <a data-value="4" class="ui-chip" href="#">4</a>
        </div>
      </div>

      <div class="space-y-1.5">
        <p class="text-sm font-medium tracking-wide opacity-80">{t(lang, "Status", "Estado")}</p>
        <div class="flex flex-wrap gap-2" data-filter="status">
          <a data-value="all" class="ui-chip" href="#">{t(lang, "All", "Todos")}</a>
          <a data-value="available" class="ui-chip" href="#">{t(lang, "Available", "Disponible")}</a>
          <a data-value="reserved" class="ui-chip" href="#">{t(lang, "Reserved", "Reservada")}</a>
          <a data-value="sold" class="ui-chip" href="#">{t(lang, "Sold", "Vendida")}</a>
          <a data-value="coming_soon" class="ui-chip" href="#">{t(lang, "Coming soon", "Próximamente")}</a>
        </div>
      </div>

      <div class="space-y-1.5">
        <p class="text-sm font-medium tracking-wide opacity-80">{t(lang, "Orientation", "Orientación")}</p>
        <div class="flex flex-wrap gap-2" data-filter="orientation">
          <a data-value="all" class="ui-chip" href="#">{t(lang, "All", "Todos")}</a>
          <a data-value="sea" class="ui-chip" href="#">{t(lang, "Sea", "Mar")}</a>
          <a data-value="city" class="ui-chip" href="#">{t(lang, "City", "Ciudad")}</a>
          <a data-value="courtyard" class="ui-chip" href="#">{t(lang, "Courtyard", "Patio")}</a>
          <a data-value="mountain" class="ui-chip" href="#">{t(lang, "Mountain", "Montaña")}</a>
        </div>
      </div>
    </div>

    <div id="units-grid" class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3" data-initial-building={initialBuilding}>
      {units.map((unit) => {
        const unitType = unit.type_id ? unitTypeById.get(unit.type_id) : undefined;
        const beds = unit.beds || unitType?.beds || "-";
        const baths = unit.baths || unitType?.baths || "-";
        const area = unit.area_m2 || unitType?.area_from || "-";
        const coverImage = String(unitType?.cover_image ?? "").trim();
        const status = String(unit.status ?? "").toLowerCase();
        const orientation = String(unit.orientation ?? "").toLowerCase();
        const building = String(unit.building_id ?? "").toLowerCase();
        const statusClass = statusClassMap[status] ?? "bg-slate-200 text-slate-800";

        return (
          <a
            href={buildUnitsHref(unit.id)}
            class="unit-card ui-card group min-h-11 overflow-hidden rounded-xl"
            data-beds={beds}
            data-status={status || "unknown"}
            data-orientation={orientation || "unknown"}
            data-building={building || "unknown"}
          >
            {coverImage && (
              <div class="aspect-[4/3] overflow-hidden border-b bg-slate-100">
                <img
                  src={coverImage}
                  alt={`${t(lang, "Unit", "Unidad")} ${unit.number || unit.id}`}
                  class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}

            <div class="unit-card__content space-y-3 p-4 sm:p-4 md:p-5">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <h2 class="text-lg font-semibold leading-tight break-words text-slate-900">
                  {t(lang, "Unit", "Unidad")} {unit.number || unit.id}
                </h2>
                <span class={`unit-card__status inline-flex min-h-7 items-center rounded-full px-2.5 py-1 text-xs font-medium ${statusClass}`}>{statusText(unit.status)}</span>
              </div>

              <p class="text-sm leading-relaxed opacity-75">
                {t(lang, "Building", "Bloque")} {String(unit.building_id ?? "-").toUpperCase()} · {t(lang, "Floor", "Planta")} {unit.floor || "-"}
              </p>

              <dl class="unit-meta grid grid-cols-2 gap-x-3 gap-y-1.5 text-sm">
                <div>
                  <dt class="opacity-65">{t(lang, "Beds/Baths", "Dorm./Baños")}</dt>
                  <dd class="font-medium">{beds}/{baths}</dd>
                </div>
                <div>
                  <dt class="opacity-65">{t(lang, "Area", "Superficie")}</dt>
                  <dd class="font-medium">{area} m²</dd>
                </div>
                <div>
                  <dt class="opacity-65">{t(lang, "Status", "Estado")}</dt>
                  <dd class="font-medium">{statusText(unit.status)}</dd>
                </div>
                <div>
                  <dt class="opacity-65">{t(lang, "Price", "Precio")}</dt>
                  <dd class="text-[0.95rem] font-semibold text-slate-900">{unit.price_eur ? `€${unit.price_eur}` : t(lang, "Request price", "Solicitar precio")}</dd>
                </div>
              </dl>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const filters = {
      building: "all",
      beds: "all",
      status: "all",
      orientation: "all"
    };

    const params = new URLSearchParams(window.location.search);
    for (const key of Object.keys(filters)) {
      const value = params.get(key);
      if (value) filters[key] = value;
    }

    const text = {
      allFilters: { en: "All filters", es: "Todos los filtros" },
      filteredBy: { en: "Filtered by", es: "Filtrado por" },
      units: { en: "units", es: "unidades" },
      building: { en: "building", es: "bloque" },
      beds: { en: "beds", es: "dorm." },
      status: { en: "status", es: "estado" },
      orientation: { en: "orientation", es: "orientación" }
    };

    const lang = document.documentElement.lang === "es" ? "es" : "en";

    const buildQuery = (next) => {
      const query = new URLSearchParams();
      for (const [key, value] of Object.entries(next)) {
        if (value && value !== "all") query.set(key, value);
      }
      const qs = query.toString();
      return `${window.location.pathname}${qs ? `?${qs}` : ""}`;
    };

    const updateFilterButtons = () => {
      document.querySelectorAll("[data-filter]").forEach((group) => {
        const key = group.getAttribute("data-filter");
        group.querySelectorAll("a[data-value]").forEach((link) => {
          const value = link.getAttribute("data-value") || "all";
          const next = { ...filters, [key]: value };
          link.setAttribute("href", buildQuery(next));
          const active = filters[key] === value;
          link.classList.toggle("is-active", active);
        });
      });
    };

    const applyCards = () => {
      let count = 0;
      document.querySelectorAll(".unit-card").forEach((card) => {
        const beds = card.getAttribute("data-beds");
        const status = card.getAttribute("data-status");
        const orientation = card.getAttribute("data-orientation");
        const building = card.getAttribute("data-building");

        const matchBuilding = filters.building === "all" || building === filters.building;
        const matchBeds = filters.beds === "all" || beds === filters.beds;
        const matchStatus = filters.status === "all" || status === filters.status;
        const matchOrientation = filters.orientation === "all" || orientation === filters.orientation;
        const visible = matchBuilding && matchBeds && matchStatus && matchOrientation;

        card.classList.toggle("hidden", !visible);
        if (visible) count += 1;
      });

      const summary = document.getElementById("units-summary");
      if (summary) summary.textContent = `${count} ${text.units[lang]}`;

      const active = [];
      if (filters.building !== "all") active.push(`${text.building[lang]}: ${filters.building.toUpperCase()}`);
      if (filters.beds !== "all") active.push(`${filters.beds} ${text.beds[lang]}`);
      if (filters.status !== "all") active.push(`${text.status[lang]}: ${filters.status}`);
      if (filters.orientation !== "all") active.push(`${text.orientation[lang]}: ${filters.orientation}`);

      const activeFilters = document.getElementById("active-filters");
      if (activeFilters) {
        activeFilters.textContent = active.length
          ? `${text.filteredBy[lang]} ${active.join(" · ")}`
          : text.allFilters[lang];
      }
    };

    updateFilterButtons();
    applyCards();
  })();
</script>
