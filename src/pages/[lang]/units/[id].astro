---
// FILE: src/pages/[lang]/units/[id].astro
// FULL REPLACE

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { type Lang, isLang, t } from "../../../content/languages";
import { getSettings, getUnitById, getUnits, getUnitTypes } from "../../../vertical/cms/sheets";
import { ATLAS_ASSETS } from "../../../vertical/content/assets";

export async function getStaticPaths() {
  const units = await getUnits();
  const langs: Lang[] = ["en", "es"];

  return units.flatMap((unit) =>
    langs.map((lang) => ({
      params: { lang, id: unit.id },
      props: { lang, id: unit.id },
    })),
  );
}

const langProp = Astro.props.lang ?? Astro.params.lang ?? "en";
if (!isLang(langProp)) throw new Error("Invalid lang");
const lang = langProp as Lang;
const id = String(Astro.props.id ?? Astro.params.id ?? "");

const settings = await getSettings();
const unit = await getUnitById(id);
const unitTypes = await getUnitTypes();
const unitType = unit?.type_id ? unitTypes.find((item) => item.id === unit.type_id) : undefined;

// Visuals (defensive). Task 12 ensures fallbacks, but still guard against empty strings.
// Accept both '|' and ',' separators (be defensive with older CSV values).
const coverImage = String(unitType?.cover_image ?? "").trim();
const planImage = String(unit?.plan_image ?? "").trim();
const galleryImages = String((unit as any)?.gallery_images ?? "")
  .split(/[|,]/)
  .map((item) => item.trim())
  .filter(Boolean);

const projectName = (lang === "es" ? settings.project_name_es : settings.project_name_en) || "Atlas Residences";
const beds = unit?.beds || unitType?.beds || "-";
const baths = unit?.baths || unitType?.baths || "-";
const area = unit?.area_m2 || unitType?.area_from || "-";

const statusText = (status?: string) => {
  const normalized = String(status ?? "").toLowerCase();
  if (normalized === "available") return t(lang, "Available", "Disponible");
  if (normalized === "reserved") return t(lang, "Reserved", "Reservada");
  if (normalized === "sold") return t(lang, "Sold", "Vendida");
  if (normalized === "coming_soon") return t(lang, "Coming soon", "PrГіximamente");
  return t(lang, "Unknown", "Sin estado");
};

const orientationText = (orientation?: string) => {
  const normalized = String(orientation ?? "").toLowerCase();
  if (normalized === "sea") return t(lang, "Sea", "Mar");
  if (normalized === "city") return t(lang, "City", "Ciudad");
  if (normalized === "courtyard") return t(lang, "Courtyard", "Patio");
  if (normalized === "mountain") return t(lang, "Mountain", "MontaГ±a");
  return t(lang, "Unknown", "Sin orientaciГіn");
};

const unitLabel = unit?.number || unit?.id || id;
const canonicalPath = `/${lang}/units/${id}/`;
const seoUrl = Astro.site ? new URL(canonicalPath, Astro.site).toString() : canonicalPath;

const seoTitle = unit
  ? `${t(lang, "Unit", "Unidad")} ${unitLabel} вЂ” ${projectName}`
  : `${t(lang, "Unit", "Unidad")} вЂ” ${projectName}`;

const seoDescription = unit
  ? `${beds} ${t(lang, "beds", "dorm.")}, ${baths} ${t(lang, "baths", "baГ±os")}, ${area} mВІ${unit?.price_eur ? `, в‚¬${unit.price_eur}` : ""}.`
  : t(lang, "Residence details are unavailable.", "Los detalles de la unidad no estГЎn disponibles.");

// Prefer gallery cover/first image, then type cover, then OG units, then masterplan.
const seoImage =
  galleryImages[0] || coverImage || ATLAS_ASSETS.og.og02Units1200x630 || ATLAS_ASSETS.masterplan.mp01Wide16x9;

const seoNoindex = !unit;
const ogLocale = lang === "es" ? "es_ES" : "en_US";

// Unit Detail Canonical Art Direction v1 вЂ” presentation aliases
// If your current file uses a different image variable name, change only these 3 alias lines.
const canonHeroImage = coverImage;
const canonPlanImage = planImage;
const canonGalleryImages = galleryImages.slice(0, 3);

const getAssetSrc = (image: unknown) => {
  if (typeof image === "string") return image;

  if (image && typeof image === "object") {
    const record = image as Record<string, unknown>;
    return String(record.src ?? record.url ?? record.image ?? "");
  }

  return "";
};

const formatCanonText = (value: unknown, fallback = "вЂ”") => {
  const text = String(value ?? "").trim();
  return text.length ? text : fallback;
};

const titleCaseCanon = (value: unknown, fallback = "вЂ”") => {
  const text = formatCanonText(value, fallback)
    .replace(/_/g, " ")
    .replace(/-/g, " ")
    .trim();

  if (!text || text === "вЂ”") return fallback;

  return text
    .split(/\s+/)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
    .join(" ");
};

const formatCanonStatus = (value: unknown) => titleCaseCanon(value, "Available");

const formatCanonBuilding = (value: unknown) => {
  const raw = formatCanonText(value, "A")
    .replace(/^building\s+/i, "")
    .trim();

  if (!raw || raw === "вЂ”") return "Building A";

  return `Building ${raw.toUpperCase()}`;
};

const formatCanonFloor = (value: unknown) => {
  const raw = formatCanonText(value, "1")
    .replace(/^floor\s+/i, "")
    .trim();

  if (!raw || raw === "вЂ”") return "Floor 1";

  return `Floor ${raw}`;
};

const formatCanonOrientation = (value: unknown) => titleCaseCanon(value, "Sea");

const formatCanonPrice = (value: unknown) => {
  const number = Number(value);

  if (!Number.isFinite(number) || number <= 0) {
    return "Request price";
  }

  return `\u20ac${number.toLocaleString(lang === "es" ? "es-ES" : "en-US")}`;
};

const canonUnitNumber = formatCanonText(unit.number ?? unit.id, "");
const canonResidenceTitle = `Unit ${canonUnitNumber}`.trim();

const canonBuildingLabel = formatCanonBuilding(
  unit.building_label ?? unit.building_id ?? unit.building ?? "A",
);

const canonFloorLabel = formatCanonFloor(
  unit.floor_label ?? unit.floor ?? "1",
);

const canonResidenceMeta = `${canonBuildingLabel} / ${canonFloorLabel}`;

const canonPriceText = formatCanonPrice(unit.price_eur ?? unit.price);
const canonStatusText = formatCanonStatus(unit.status);
const canonAreaText = unit.area_m2 ? `${unit.area_m2} m\u00b2` : "—";
const canonBedsBathsText = `${formatCanonText(unit.beds, "вЂ”")} / ${formatCanonText(unit.baths, "вЂ”")}`;
const canonOrientationText = formatCanonOrientation(unit.orientation);

const canonHeroSrc = getAssetSrc(canonHeroImage);
const canonPlanSrc = getAssetSrc(canonPlanImage);

const canonGalleryItems = canonGalleryImages
  .map((image, index) => {
    const captions = ["Arrival facade", "Terrace outlook", "Living atmosphere"];

    return {
      src: getAssetSrc(image),
      caption: captions[index] ?? "Residence view",
      alt: `${canonResidenceTitle} В· ${captions[index] ?? "Residence view"}`,
    };
  })
  .filter((item) => item.src);

const canonResidenceKicker = "Private residence";
const canonResidenceLead =
  "A refined residence designed around light, proportion, and a calm indoor-outdoor rhythm.";
const canonResidenceSecondary = "Selected residence within Atlas Residences.";

const canonPlanKicker = "Plan & proportion";
const canonPlanTitle = "A layout shaped for calm daily living";
const canonPlanBody =
  "The residence is organised around an open living and dining area, a private sleeping zone, and a compact exterior extension. The plan prioritises light, circulation, and efficient use of space without compromising comfort.";

const canonGalleryKicker = "Residence views";
const canonGalleryTitle = "Interior atmosphere and exterior presence";
const canonGalleryBody =
  "A curated selection of views showing the architectural language, material atmosphere, and outdoor character of the residence.";

const canonSummaryKicker = "Residence details";

const canonBookHref = `/${lang}/contact/?source=viewing&unit=${encodeURIComponent(String(unit.id))}`;
const canonPricingHref = `/${lang}/contact/?source=pricing&unit=${encodeURIComponent(String(unit.id))}`;

const canonHeroFacts = [
  { label: "Residence", value: canonResidenceTitle },
  { label: "Status", value: canonStatusText },
  { label: "Building", value: canonBuildingLabel },
  { label: "From", value: canonPriceText },
  { label: "Area", value: canonAreaText },
  { label: "Orientation", value: canonOrientationText },
  { label: "Bedrooms / bathrooms", value: canonBedsBathsText },
];

const canonSummaryFacts = [
  { label: "Price", value: canonPriceText },
  { label: "Status", value: canonStatusText },
  { label: "Area", value: canonAreaText },
  { label: "Bedrooms / bathrooms", value: canonBedsBathsText },
  { label: "Orientation", value: canonOrientationText },
];
---

<BaseLayout lang={lang} title={seoTitle}>
  <Fragment slot="head">
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={seoImage} />
    <meta property="og:url" content={seoUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={seoImage} />
    <meta name="twitter:url" content={seoUrl} />
    {seoNoindex && <meta name="robots" content="noindex,nofollow" />}
  </Fragment>

  {!unit ? (
    <section class="ui-card space-y-4 rounded-xl p-5">
      <h1 class="text-2xl font-semibold tracking-tight">{t(lang, "Unit not found", "Unidad no encontrada")}</h1>
      <p class="text-sm opacity-75">
        {t(
          lang,
          "This residence is no longer available or the link is incorrect.",
          "Esta residencia ya no estГЎ disponible o el enlace es incorrecto.",
        )}
      </p>
      <a class="ui-btn inline-flex items-center" href={`/${lang}/units/`}>
        {t(lang, "Back to units", "Volver a unidades")}
      </a>
    </section>
  ) : (
    <section class="unit-detail-premium-page unit-detail-canon-v1">
      <section class="unit-detail-editorial-hero" aria-labelledby="unit-detail-title">
        <div class="unit-detail-editorial-hero__media">
          <img
            class="unit-detail-editorial-hero__image"
            src={canonHeroSrc}
            alt={canonResidenceTitle}
            loading="eager"
            decoding="async"
          />

          <!-- LEFT EDITORIAL COPY: MUST LIVE INSIDE HERO IMAGE ZONE -->
          <div class="unit-detail-editorial-hero__copy">
            <p class="unit-detail-editorial-hero__eyebrow">Private Residence</p>

            <h1 id="unit-detail-title" class="unit-detail-editorial-hero__title">
              {canonResidenceTitle}
            </h1>

            <p class="unit-detail-editorial-hero__lede">
              A refined residence designed around light, proportion, and a calm indoor-outdoor rhythm.
            </p>

            <p class="unit-detail-editorial-hero__micro">
              Selected residence within Atlas Residences.
            </p>
          </div>

          <!-- RIGHT FLOATING FACTS CARD -->
          <aside class="unit-detail-editorial-hero__card" aria-label="Residence summary">
            <div class="unit-detail-editorial-hero__facts">
              <div class="unit-detail-editorial-hero__fact">
                <dt>Residence</dt>
                <dd>{canonResidenceTitle}</dd>
              </div>

              <div class="unit-detail-editorial-hero__fact">
                <dt>Status</dt>
                <dd>{canonStatusText}</dd>
              </div>

              <div class="unit-detail-editorial-hero__fact">
                <dt>Building</dt>
                <dd>{canonBuildingLabel}</dd>
              </div>

              <div class="unit-detail-editorial-hero__fact">
                <dt>From</dt>
                <dd>{canonPriceText}</dd>
              </div>

              <div class="unit-detail-editorial-hero__fact">
                <dt>Area</dt>
                <dd>{canonAreaText}</dd>
              </div>

              <div class="unit-detail-editorial-hero__fact">
                <dt>Orientation</dt>
                <dd>{canonOrientationText}</dd>
              </div>

              <div class="unit-detail-editorial-hero__fact">
                <dt>Bedrooms / Bathrooms</dt>
                <dd>{canonBedsBathsText}</dd>
              </div>
            </div>

            <div class="unit-detail-editorial-hero__actions">
              <a class="unit-detail-editorial-hero__action unit-detail-editorial-hero__action--primary" href={canonBookHref}>
                Book a viewing
              </a>

              <a class="unit-detail-editorial-hero__action unit-detail-editorial-hero__action--secondary" href={canonPricingHref}>
                Request pricing
              </a>
            </div>
          </aside>
        </div>
      </section>

      <section class="unit-detail-canon-section unit-detail-canon-plan" aria-labelledby="unit-plan-title">
        <div class="unit-detail-canon-section-head">
          <p class="unit-detail-canon-kicker">{canonPlanKicker}</p>

          <h2 id="unit-plan-title" class="unit-detail-canon-section-title">
            {canonPlanTitle}
          </h2>

          <p class="unit-detail-canon-section-body">
            {canonPlanBody}
          </p>
        </div>

        <figure class="unit-detail-premium-plan unit-detail-canon-plan__plate">
          <img
            src={canonPlanSrc}
            alt={`${canonResidenceTitle} floor plan`}
            loading="lazy"
            decoding="async"
          />

          <figcaption class="unit-detail-canon-caption">
            Architectural plan · indicative layout
          </figcaption>
        </figure>
      </section>

      <section class="unit-detail-canon-section unit-detail-canon-gallery" aria-labelledby="unit-gallery-title">
        <div class="unit-detail-canon-section-head">
          <p class="unit-detail-canon-kicker">{canonGalleryKicker}</p>

          <h2 id="unit-gallery-title" class="unit-detail-canon-section-title">
            {canonGalleryTitle}
          </h2>

          <p class="unit-detail-canon-section-body">
            {canonGalleryBody}
          </p>
        </div>

        <div class="unit-detail-premium-gallery unit-detail-canon-gallery__grid">
          {canonGalleryItems.map((item, index) => (
            <figure
              class:list={[
                "unit-detail-premium-gallery__item",
                "unit-detail-canon-gallery__item",
                index === 0 && "unit-detail-canon-gallery__item--primary",
              ]}
            >
              <img
                src={item.src}
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />

              <figcaption class="unit-detail-canon-gallery__caption">
                {item.caption}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="unit-detail-premium-summary unit-detail-canon-summary" aria-labelledby="unit-summary-title">
        <div class="unit-detail-canon-summary__copy">
          <p class="unit-detail-canon-kicker">{canonSummaryKicker}</p>

          <h2 id="unit-summary-title" class="unit-detail-canon-summary__title">
            {canonResidenceTitle}
          </h2>

          <p class="unit-detail-canon-summary__meta">{canonResidenceMeta}</p>
        </div>

        <dl class="unit-detail-canon-summary__facts">
          {canonSummaryFacts.map((fact) => (
            <div class="unit-detail-canon-summary__fact">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>

        <div class="unit-detail-canon-summary__actions">
          <a class="unit-detail-canon-button unit-detail-canon-button--primary" href={canonPricingHref}>
            <span>Request pricing</span>
            <span class="home-action-arrow" aria-hidden="true"></span>
          </a>

          <a class="unit-detail-canon-button unit-detail-canon-button--secondary" href={canonBookHref}>
            <span>Book a viewing</span>
            <span class="home-action-arrow" aria-hidden="true"></span>
          </a>
        </div>
      </section>
    </section>
  )}
</BaseLayout>




