---
// FILE: src/pages/[lang]/units/[id].astro
// FULL REPLACE

import BaseLayout from "../../../core/layouts/BaseLayout.astro";
import DeveloperHeader from "../../../vertical/ui/DeveloperHeader.astro";
import StickyCTA from "../../../vertical/ui/StickyCTA.astro";
import { type Lang, isLang, t } from "../../../content/languages";
import { getSettings, getUnitById, getUnits, getUnitTypes } from "../../../vertical/cms/sheets";
import { ATLAS_ASSETS } from "../../../vertical/content/assets";

export async function getStaticPaths() {
  const units = await getUnits();
  const langs: Lang[] = ["en", "es"];

  return units.flatMap((unit) =>
    langs.map((lang) => ({
      params: { lang, id: unit.id },
      props: { lang, id: unit.id },
    })),
  );
}

const langProp = Astro.props.lang ?? Astro.params.lang ?? "en";
if (!isLang(langProp)) throw new Error("Invalid lang");
const lang = langProp as Lang;
const id = String(Astro.props.id ?? Astro.params.id ?? "");

const settings = await getSettings();
const unit = await getUnitById(id);
const unitTypes = await getUnitTypes();
const unitType = unit?.type_id ? unitTypes.find((item) => item.id === unit.type_id) : undefined;

// Visuals (defensive). Task 12 ensures fallbacks, but still guard against empty strings.
// Accept both '|' and ',' separators (be defensive with older CSV values).
const coverImage = String(unitType?.cover_image ?? "").trim();
const planImage = String(unit?.plan_image ?? "").trim();
const galleryImages = String((unit as any)?.gallery_images ?? "")
  .split(/[|,]/)
  .map((item) => item.trim())
  .filter(Boolean);

const projectName = (lang === "es" ? settings.project_name_es : settings.project_name_en) || "Atlas Residences";
const beds = unit?.beds || unitType?.beds || "-";
const baths = unit?.baths || unitType?.baths || "-";
const area = unit?.area_m2 || unitType?.area_from || "-";

const statusText = (status?: string) => {
  const normalized = String(status ?? "").toLowerCase();
  if (normalized === "available") return t(lang, "Available", "Disponible");
  if (normalized === "reserved") return t(lang, "Reserved", "Reservada");
  if (normalized === "sold") return t(lang, "Sold", "Vendida");
  if (normalized === "coming_soon") return t(lang, "Coming soon", "Próximamente");
  return t(lang, "Unknown", "Sin estado");
};

const orientationText = (orientation?: string) => {
  const normalized = String(orientation ?? "").toLowerCase();
  if (normalized === "sea") return t(lang, "Sea", "Mar");
  if (normalized === "city") return t(lang, "City", "Ciudad");
  if (normalized === "courtyard") return t(lang, "Courtyard", "Patio");
  if (normalized === "mountain") return t(lang, "Mountain", "Montaña");
  return t(lang, "Unknown", "Sin orientación");
};

const unitLabel = unit?.number || unit?.id || id;
const canonicalPath = `/${lang}/units/${id}/`;
const seoUrl = Astro.site ? new URL(canonicalPath, Astro.site).toString() : canonicalPath;

const seoTitle = unit
  ? `${t(lang, "Unit", "Unidad")} ${unitLabel} — ${projectName}`
  : `${t(lang, "Unit", "Unidad")} — ${projectName}`;

const seoDescription = unit
  ? `${beds} ${t(lang, "beds", "dorm.")}, ${baths} ${t(lang, "baths", "baños")}, ${area} m²${unit?.price_eur ? `, €${unit.price_eur}` : ""}.`
  : t(lang, "Unit details are unavailable.", "Los detalles de la unidad no están disponibles.");

// Prefer gallery cover/first image, then type cover, then OG units, then masterplan.
const seoImage =
  galleryImages[0] || coverImage || ATLAS_ASSETS.og.og02Units1200x630 || ATLAS_ASSETS.masterplan.mp01Wide16x9;

const seoNoindex = !unit;
const ogLocale = lang === "es" ? "es_ES" : "en_US";
---

<BaseLayout lang={lang} title={seoTitle}>
  <DeveloperHeader slot="header" lang={lang} pathname={Astro.url.pathname} />
  <Fragment slot="head">
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={seoImage} />
    <meta property="og:url" content={seoUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={seoImage} />
    <meta name="twitter:url" content={seoUrl} />
    {seoNoindex && <meta name="robots" content="noindex,nofollow" />}
  </Fragment>

  {!unit ? (
    <section class="ui-card space-y-4 rounded-xl p-5">
      <h1 class="text-2xl font-semibold tracking-tight">{t(lang, "Unit not found", "Unidad no encontrada")}</h1>
      <p class="text-sm opacity-75">
        {t(
          lang,
          "This unit is no longer available or the link is incorrect.",
          "Esta unidad ya no está disponible o el enlace es incorrecto.",
        )}
      </p>
      <a class="ui-btn inline-flex items-center" href={`/${lang}/units/`}>
        {t(lang, "Back to units", "Volver a unidades")}
      </a>
    </section>
  ) : (
    <section class="unit-detail-flow space-y-5 sm:space-y-6">
      <div class="unit-detail-gallery-stack space-y-3.5 sm:space-y-4">
        {coverImage && (
          <img
            src={coverImage}
            alt={`${t(lang, "Unit", "Unidad")} ${unit.number || unit.id}`}
            class="w-full rounded-xl border object-cover unit-detail-media"
            loading="lazy"
            decoding="async"
          />
        )}

        {planImage && (
          <img
            src={planImage}
            alt={`${t(lang, "Unit plan", "Plano de unidad")} ${unit.number || unit.id}`}
            class="w-full rounded-xl border object-cover unit-detail-media"
            loading="lazy"
            decoding="async"
          />
        )}

        {galleryImages.length > 0 && (
          <div class="grid gap-3.5 sm:grid-cols-2 unit-detail-gallery">
            {galleryImages.map((image, index) => (
              <img
                src={image}
                alt={`${t(lang, "Gallery image", "Imagen de galería")} ${index + 1}`}
                class="w-full rounded-xl border object-cover unit-detail-media"
                loading="lazy"
                decoding="async"
              />
            ))}
          </div>
        )}
      </div>

      <div class="unit-detail-summary ui-card rounded-xl p-4 sm:p-5">
        <header class="unit-detail-headline space-y-2.5">
          <p class="unit-detail-kicker">{t(lang, "Unit details", "Detalles de unidad")}</p>
          <h1 class="text-3xl tracking-tight">
            {t(lang, "Unit", "Unidad")} {unit.number || unit.id}
          </h1>
          <p class="unit-detail-context text-sm">
            {t(lang, "Building", "Bloque")} {String(unit.building_id ?? "-").toUpperCase()} · {t(lang, "Floor", "Planta")}{" "}
            {unit.floor || "-"}
          </p>
        </header>

        <div class="unit-detail-meta mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <div class="unit-detail-stat unit-detail-price">
            <p class="unit-detail-label">{t(lang, "Price", "Precio")}</p>
            <p class="unit-detail-value text-xl font-semibold">
              {unit.price_eur ? `€${unit.price_eur}` : t(lang, "Request price", "Solicitar precio")}
            </p>
          </div>
          <div class="unit-detail-stat unit-detail-status">
            <p class="unit-detail-label">{t(lang, "Status", "Estado")}</p>
            <p class="unit-detail-value text-lg font-medium">{statusText(unit.status)}</p>
          </div>
          <div class="unit-detail-stat unit-detail-area">
            <p class="unit-detail-label">{t(lang, "Area", "Superficie")}</p>
            <p class="unit-detail-value text-lg font-medium">{area} m²</p>
          </div>
        </div>

        <div class="unit-detail-spec-grid mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <div class="unit-detail-stat">
            <p class="unit-detail-label">{t(lang, "Beds / Baths", "Dormitorios / Baños")}</p>
            <p class="unit-detail-value text-base font-medium">
              {beds} / {baths}
            </p>
          </div>
          <div class="unit-detail-stat">
            <p class="unit-detail-label">{t(lang, "Orientation", "Orientación")}</p>
            <p class="unit-detail-value text-base font-medium">{orientationText(unit.orientation)}</p>
          </div>
        </div>

        <div class="unit-detail-cta-row unit-cta-row mt-5 flex flex-col gap-2.5 sm:flex-row sm:items-center">
          <a
            class="ui-btn ui-btn--primary inline-flex items-center justify-center px-6"
            href={`/${lang}/downloads/`}
          >
            {t(lang, "Request price list", "Solicitar lista de precios")}
          </a>
          <a
            class="ui-btn inline-flex items-center justify-center px-6"
            href={`/${lang}/contact/?source=unit&unit=${encodeURIComponent(String(unit.id ?? ""))}`}
          >
            {t(lang, "Book a viewing", "Reservar visita")}
          </a>
        </div>
      </div>
    </section>
  )}
  <StickyCTA lang={lang} />
</BaseLayout>
