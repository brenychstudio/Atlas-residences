---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LANGS, type Lang, isLang, t } from "../../content/languages";
import { getDocuments, getPageBySlug, getSettings } from "../../vertical/cms/sheets";
import { ATLAS_ASSETS } from "../../vertical/content/assets";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const lang = langParam as Lang;

const p0 = Astro.url.pathname;
const p = p0.endsWith("/") ? p0 : `${p0}/`;
const [settings, pageSeo, documents] = await Promise.all([getSettings(), getPageBySlug(p), getDocuments()]);

const projectName = (lang === "es" ? settings.project_name_es : settings.project_name_en) || "Atlas Residences";
const defaultDescription =
  (lang === "es" ? settings.tagline_es : settings.tagline_en) ||
  t(lang, "Download brochures, price lists and project files.", "Descarga folletos, listas de precios y archivos del proyecto.");

const seoTitle = (lang === "es" ? pageSeo?.title_es : pageSeo?.title_en) || `${t(lang, "Downloads", "Descargas")} — ${projectName}`;
const seoDescription = (lang === "es" ? pageSeo?.description_es : pageSeo?.description_en) || defaultDescription;
const seoImage = pageSeo?.og_image || ATLAS_ASSETS.og.og01Home1200x630 || ATLAS_ASSETS.masterplan.mp01Wide16x9;
const seoNoindex = String(pageSeo?.noindex ?? "").toLowerCase() === "true";
const ogLocale = lang === "es" ? "es_ES" : "en_US";

const normalizedDocs = documents
  .map((doc) => {
    const title = lang === "es" ? doc.title_es : doc.title_en;
    const directUrl = lang === "es" ? doc.url_es : doc.url_en;

    let fallbackUrl = "";
    if (doc.type === "brochure") {
      fallbackUrl = lang === "es" ? settings.brochure_url_es ?? "" : settings.brochure_url_en ?? "";
    }
    if (doc.type === "price_list") {
      fallbackUrl = lang === "es" ? settings.price_list_url_es ?? "" : settings.price_list_url_en ?? "";
    }

    const url = directUrl || fallbackUrl;
    const gatedValue = String(doc.gated ?? "").toLowerCase();
    const gated = gatedValue === "true" || gatedValue === "1" || gatedValue === "yes";

    return {
      id: doc.id,
      type: doc.type ?? "document",
      title,
      url,
      gated,
    };
  })
  .filter((doc) => doc.title && doc.url);

const typeText = (type: string) => {
  const normalized = String(type).toLowerCase();
  if (normalized === "brochure") return t(lang, "Brochure", "Folleto");
  if (normalized === "price_list") return t(lang, "Price list", "Lista de precios");
  if (normalized === "specs") return t(lang, "Specs", "Especificaciones");
  if (normalized === "finishes") return t(lang, "Finishes", "Acabados");
  if (normalized === "legal") return t(lang, "Legal", "Legal");
  return t(lang, "Document", "Documento");
};
---

<BaseLayout lang={lang} title={seoTitle}>
  <Fragment slot="head">
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={seoImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={seoImage} />
    {seoNoindex && <meta name="robots" content="noindex,nofollow" />}
  </Fragment>

  <section class="space-y-5">
    <header class="space-y-2">
      <h1 class="text-3xl tracking-tight">{t(lang, "Downloads", "Descargas")}</h1>
      <p class="text-sm opacity-80">
        {t(lang, "Download brochures, price lists and project files.", "Descarga folletos, listas de precios y archivos del proyecto.")}
      </p>
    </header>

    <div class="grid gap-3">
      {normalizedDocs.map((doc) => (
        <article class="rounded-xl border p-4">
          <div class="flex flex-wrap items-center gap-2">
            <p class="text-xs uppercase tracking-wide opacity-70">{typeText(doc.type)}</p>
            {doc.gated && (
              <span class="rounded-full bg-black px-2 py-1 text-xs font-medium text-white">{t(lang, "Gated", "Con formulario")}</span>
            )}
          </div>

          <h2 class="mt-2 text-lg font-semibold break-words">{doc.title}</h2>

          <div class="mt-4">
            {doc.gated ? (
              <button
                type="button"
                class="inline-flex min-h-11 items-center rounded-lg bg-black px-4 py-2 font-medium text-white"
                data-open-lead
                data-doc-id={doc.id}
              >
                {t(lang, "Download", "Descargar")}
              </button>
            ) : (
              <a
                href={doc.url}
                target="_blank"
                rel="noreferrer"
                class="inline-flex min-h-11 items-center rounded-lg border px-4 py-2 font-medium"
              >
                {t(lang, "Download", "Descargar")}
              </a>
            )}
          </div>
        </article>
      ))}

      {normalizedDocs.length === 0 && (
        <p class="rounded-xl border p-4 text-sm opacity-80">{t(lang, "No documents available yet.", "Aún no hay documentos disponibles.")}</p>
      )}
    </div>
  </section>

  <dialog id="lead-dialog" class="w-full max-w-lg rounded-xl p-0 backdrop:bg-black/50">
    <form method="dialog" class="border-b p-4">
      <div class="flex items-center justify-between gap-3">
        <h3 class="text-xl font-semibold">{t(lang, "Request download", "Solicitar descarga")}</h3>
        <button type="button" id="lead-close" class="min-h-11 min-w-11 rounded-lg border px-3">×</button>
      </div>
      <p id="lead-doc-title" class="mt-2 text-sm opacity-80"></p>
    </form>

    <form id="lead-form" class="space-y-3 p-4">
      <label class="grid gap-1 text-sm">
        <span>{t(lang, "Name", "Nombre")}</span>
        <input name="name" class="min-h-11 rounded-lg border px-3" autocomplete="name" />
      </label>

      <label class="grid gap-1 text-sm">
        <span>{t(lang, "Email", "Correo")}</span>
        <input name="email" type="email" required class="min-h-11 rounded-lg border px-3" autocomplete="email" />
      </label>

      <label class="grid gap-1 text-sm">
        <span>{t(lang, "Phone", "Teléfono")}</span>
        <input name="phone" class="min-h-11 rounded-lg border px-3" autocomplete="tel" />
      </label>

      <label class="sr-only" aria-hidden="true">
        Website
        <input name="website" tabindex="-1" autocomplete="off" />
      </label>

      <label class="flex items-start gap-2 text-sm">
        <input name="consent" type="checkbox" required class="mt-1 h-4 w-4" />
        <span>{t(lang, "I agree to be contacted about this request.", "Acepto ser contactado sobre esta solicitud.")}</span>
      </label>

      <button type="submit" class="inline-flex min-h-11 items-center rounded-lg bg-black px-4 py-2 font-medium text-white">
        {t(lang, "Submit", "Enviar")}
      </button>
    </form>

    <div id="lead-result" class="hidden space-y-2 border-t p-4">
      <p class="text-sm font-medium">{t(lang, "Your file is ready.", "Tu archivo está listo.")}</p>
      <a id="lead-open-file" href="#" target="_blank" rel="noreferrer" class="inline-flex min-h-11 items-center rounded-lg border px-4 py-2 font-medium">
        {t(lang, "Open file", "Abrir archivo")}
      </a>
    </div>
  </dialog>
</BaseLayout>

<script id="downloads-data" type="application/json" set:html={JSON.stringify({
  docs: normalizedDocs,
  text: {
    unknown: t(lang, "Document", "Documento"),
  },
})} />

<script is:inline>
  (() => {
    const dataEl = document.getElementById("downloads-data");
    if (!dataEl) return;
    const data = JSON.parse(dataEl.textContent || "{}");

    const dialog = document.getElementById("lead-dialog");
    const form = document.getElementById("lead-form");
    const result = document.getElementById("lead-result");
    const openFile = document.getElementById("lead-open-file");
    const closeButton = document.getElementById("lead-close");
    const titleNode = document.getElementById("lead-doc-title");

    if (!dialog || !form || !result || !openFile || !closeButton || !titleNode) return;

    let activeDoc = null;
    let lastFocused = null;

    const focusables = () => Array.from(dialog.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'))
      .filter((el) => !el.hasAttribute("disabled") && el.getAttribute("aria-hidden") !== "true");

    const openLead = (docId) => {
      const doc = (data.docs || []).find((item) => item.id === docId);
      if (!doc) return;
      activeDoc = doc;
      lastFocused = document.activeElement;
      titleNode.textContent = doc.title || data.text.unknown;
      result.classList.add("hidden");
      form.classList.remove("hidden");
      form.reset();
      dialog.showModal();
      const first = form.querySelector('input[name="name"]') || focusables()[0];
      if (first) first.focus();
    };

    const closeLead = () => {
      if (dialog.open) dialog.close();
      if (lastFocused && typeof lastFocused.focus === "function") lastFocused.focus();
    };

    document.querySelectorAll("[data-open-lead]").forEach((button) => {
      button.addEventListener("click", () => {
        openLead(button.getAttribute("data-doc-id"));
      });
    });

    closeButton.addEventListener("click", closeLead);

    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeLead();
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        closeLead();
        return;
      }
      if (event.key !== "Tab") return;
      const items = focusables();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!activeDoc) return;

      const formData = new FormData(form);
      const honeypot = String(formData.get("website") || "").trim();
      if (honeypot) {
        closeLead();
        return;
      }

      console.log(`[lead] submit downloads:${activeDoc.id}`);
      form.classList.add("hidden");
      result.classList.remove("hidden");
      openFile.setAttribute("href", activeDoc.url);
      window.open(activeDoc.url, "_blank", "noopener,noreferrer");
    });
  })();
</script>
