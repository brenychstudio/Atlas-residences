---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LANGS, type Lang, isLang, t } from "../../content/languages";
import { getSettings } from "../../vertical/cms/sheets";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const lang = langParam as Lang;

const settings = await getSettings();
const brochureUrl = String((lang === "es" ? settings.brochure_url_es : settings.brochure_url_en) ?? "").trim();
const priceListUrl = String((lang === "es" ? settings.price_list_url_es : settings.price_list_url_en) ?? "").trim();
const hasDownloads = Boolean(brochureUrl || priceListUrl);
---

<BaseLayout lang={lang} title={t(lang, "Downloads | Atlas Residences", "Descargas | Atlas Residences") }>
  <section class="downloads-shell space-y-5 sm:space-y-6">
    <header class="downloads-head space-y-1.5">
      <h1 class="text-3xl tracking-tight">{t(lang, "Downloads", "Descargas")}</h1>
      <p class="max-w-2xl text-sm opacity-80">{t(lang, "Brochures and sales documents in one place.", "Folletos y documentos comerciales en un solo lugar.")}</p>
    </header>

    <div class="cta-cluster cta-inline flex flex-col gap-2 sm:flex-row sm:items-center">
      <a class="cta-primary ui-btn ui-btn--primary inline-flex items-center justify-center" href={`/${lang}/contact/?source=downloads`}>
        {t(lang, "Speak with sales", "Hablar con ventas")}
      </a>
      <a class="cta-secondary ui-btn inline-flex items-center justify-center" href={`/${lang}/units/`}>
        {t(lang, "Browse available units", "Explorar unidades disponibles")}
      </a>
    </div>

    {hasDownloads ? (

    <div class="downloads-grid grid gap-3.5 sm:grid-cols-2 sm:gap-3.5">
      {brochureUrl && (
        <a
          class="download-card ui-card group flex h-full flex-col overflow-hidden rounded-xl"
          href={brochureUrl}
        >
          <img
            src={brochureUrl}
            alt={t(lang, "Project brochure cover", "Portada del folleto del proyecto")}
            class="aspect-[4/5] w-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <div class="mt-auto space-y-2 p-4 sm:p-5">
            <p class="text-sm font-semibold">{t(lang, "Project brochure", "Folleto del proyecto")}</p>
            <p class="text-xs opacity-70">{t(lang, "Sales document", "Documento comercial")}</p>
            <p class="text-xs font-medium uppercase tracking-[0.1em] opacity-75">{t(lang, "View document", "Ver documento")}</p>
          </div>
        </a>
      )}

      {priceListUrl && (
        <a
          class="download-card ui-card group flex h-full flex-col overflow-hidden rounded-xl"
          href={priceListUrl}
        >
          <img
            src={priceListUrl}
            alt={t(lang, "Price list cover", "Portada de lista de precios")}
            class="aspect-[4/5] w-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <div class="mt-auto space-y-2 p-4 sm:p-5">
            <p class="text-sm font-semibold">{t(lang, "Price list", "Lista de precios")}</p>
            <p class="text-xs opacity-70">{t(lang, "Sales document", "Documento comercial")}</p>
            <p class="text-xs font-medium uppercase tracking-[0.1em] opacity-75">{t(lang, "View document", "Ver documento")}</p>
          </div>
        </a>
      )}
    </div>
    ) : (
      <div class="downloads-empty ui-card space-y-3 rounded-xl p-5 sm:p-6">
        <p class="text-sm opacity-80">
          {t(lang, "Downloads will be available soon.", "Las descargas estarán disponibles pronto.")}
        </p>
        <a class="ui-btn cta-secondary inline-flex items-center text-sm" href={`/${lang}/contact/?source=downloads`}>
          {t(lang, "Contact sales", "Contactar ventas")}
        </a>
      </div>
    )}
  </section>
</BaseLayout>
