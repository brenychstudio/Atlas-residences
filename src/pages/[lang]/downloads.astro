---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LANGS, type Lang, isLang, t } from "../../content/languages";
import { getSettings } from "../../vertical/cms/sheets";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const lang = langParam as Lang;

const settings = await getSettings();
const brochureUrl = String((lang === "es" ? settings.brochure_url_es : settings.brochure_url_en) ?? "").trim();
const priceListUrl = String((lang === "es" ? settings.price_list_url_es : settings.price_list_url_en) ?? "").trim();
const hasDownloads = Boolean(brochureUrl || priceListUrl);
---

<BaseLayout lang={lang} title={t(lang, "Downloads | Atlas Residences", "Descargas | Atlas Residences")}>
  <section class="downloads-premium-shell downloads-layout">
    <header class="downloads-premium-hero">
      <div class="downloads-premium-hero__copy">
        <p class="downloads-premium-kicker">
          {t(lang, "Sales documents", "Documentos comerciales")}
        </p>

        <h1 class="downloads-premium-title">
          {t(lang, "Private document library", "Biblioteca privada de documentos")}
        </h1>

        <p class="downloads-premium-lede">
          {t(
            lang,
            "Review the project brochure, price list and selected sales material prepared for private residence enquiries.",
            "Consulta el folleto del proyecto, la lista de precios y el material comercial seleccionado para solicitudes privadas.",
          )}
        </p>
      </div>

      <aside class="downloads-premium-hero__card">
        <p class="downloads-premium-card-kicker">
          {t(lang, "Sales access", "Acceso comercial")}
        </p>

        <h2>
          {t(lang, "Documents prepared for review", "Documentos preparados para revisión")}
        </h2>

        <p>
          {t(
            lang,
            "Request the latest availability, arrange a private viewing, or speak directly with the sales team.",
            "Solicita la disponibilidad actual, organiza una visita privada o contacta directamente con el equipo comercial.",
          )}
        </p>

        <div class="downloads-premium-hero__actions">
          <a class="downloads-premium-button downloads-premium-button--primary" href={`/${lang}/contact/`}>
            <span>{t(lang, "Speak with sales", "Hablar con ventas")}</span>
            <span aria-hidden="true">→</span>
          </a>

          <a class="downloads-premium-button downloads-premium-button--secondary" href={`/${lang}/units/`}>
            <span>{t(lang, "Browse available units", "Ver unidades disponibles")}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </aside>
    </header>

    {hasDownloads ? (
      <div class="downloads-premium-grid">
        {brochureUrl && (
          <article class="downloads-premium-card">
            <a href={brochureUrl} class="downloads-premium-card__media">
              <img
                src={brochureUrl}
                alt={t(lang, "Project brochure cover", "Portada del folleto del proyecto")}
                class="downloads-premium-card__image"
                loading="lazy"
                decoding="async"
              />
            </a>

            <div class="downloads-premium-card__body">
              <div>
                <h2 class="downloads-premium-card__title">
                  {t(lang, "Project brochure", "Folleto del proyecto")}
                </h2>

                <p class="downloads-premium-card__meta">
                  {t(lang, "Sales document", "Documento comercial")}
                </p>
              </div>

              <a href={brochureUrl} class="downloads-premium-card__link">
                <span>{t(lang, "View document", "Ver documento")}</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        )}

        {priceListUrl && (
          <article class="downloads-premium-card">
            <a href={priceListUrl} class="downloads-premium-card__media">
              <img
                src={priceListUrl}
                alt={t(lang, "Price list cover", "Portada de lista de precios")}
                class="downloads-premium-card__image"
                loading="lazy"
                decoding="async"
              />
            </a>

            <div class="downloads-premium-card__body">
              <div>
                <h2 class="downloads-premium-card__title">
                  {t(lang, "Price list", "Lista de precios")}
                </h2>

                <p class="downloads-premium-card__meta">
                  {t(lang, "Sales document", "Documento comercial")}
                </p>
              </div>

              <a href={priceListUrl} class="downloads-premium-card__link">
                <span>{t(lang, "View document", "Ver documento")}</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        )}
      </div>
    ) : (
      <section class="downloads-premium-empty">
        <p class="downloads-premium-card-kicker">
          {t(lang, "Coming soon", "Próximamente")}
        </p>

        <h2>{t(lang, "Downloads will be available soon.", "Las descargas estarán disponibles pronto.")}</h2>
      </section>
    )}
  </section>
</BaseLayout>
