---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LANGS, type Lang, isLang, t } from "../../content/languages";
import { getAmenities, getBuildings, getPageBySlug, getSettings, getUnits } from "../../vertical/cms/sheets";
import { ATLAS_ASSETS } from "../../vertical/content/assets";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const lang = langParam as Lang;

const p0 = Astro.url.pathname;
const p = p0.endsWith("/") ? p0 : `${p0}/`;
const [settings, pageSeo] = await Promise.all([getSettings(), getPageBySlug(p)]);

const projectName = (lang === "es" ? settings.project_name_es : settings.project_name_en) || "Atlas Residences";
const defaultDescription =
  (lang === "es" ? settings.tagline_es : settings.tagline_en) ||
  t(lang, "Explore Atlas residences on the masterplan.", "Explora Atlas Residences en el plan maestro.");

const seoTitle = (lang === "es" ? pageSeo?.title_es : pageSeo?.title_en) || `${t(lang, "Masterplan", "Plan maestro")} — ${projectName}`;
const seoDescription = (lang === "es" ? pageSeo?.description_es : pageSeo?.description_en) || defaultDescription;
const seoImage = pageSeo?.og_image || ATLAS_ASSETS.masterplan.mp01Wide16x9 || ATLAS_ASSETS.og.og01Home1200x630;
const seoNoindex = String(pageSeo?.noindex ?? "").toLowerCase() === "true";
const ogLocale = lang === "es" ? "es_ES" : "en_US";

const searchParams = Astro.url.searchParams;
const bedsParam = searchParams.get("beds") ?? "all";
const statusParam = searchParams.get("status") ?? "all";
const initialBeds = ["all", "1", "2", "3", "4"].includes(bedsParam) ? bedsParam : "all";
const initialStatus = ["all", "available", "reserved", "sold", "coming_soon"].includes(statusParam)
  ? statusParam
  : "all";

const [buildings, amenities, units] = await Promise.all([getBuildings(), getAmenities(), getUnits()]);
const masterplanImage = ATLAS_ASSETS.masterplan?.mp01Wide16x9 || "/atlas/masterplan/mp-01-wide-16x9.png";

const normalizedUnits = units.map((unit) => ({
  buildingId: String(unit.building_id ?? "").toLowerCase(),
  beds: String(unit.beds ?? "").toLowerCase(),
  status: String(unit.status ?? "").toLowerCase(),
}));

const filteredUnits = normalizedUnits.filter((unit) => {
  const bedsMatch = initialBeds === "all" || unit.beds === initialBeds;
  const statusMatch = initialStatus === "all" || unit.status === initialStatus;
  return bedsMatch && statusMatch;
});

const buildingCounts = new Map<string, number>();
for (const unit of filteredUnits) {
  buildingCounts.set(unit.buildingId, (buildingCounts.get(unit.buildingId) ?? 0) + 1);
}

const statusText = (status: string) => {
  if (status === "available") return t(lang, "Available", "Disponible");
  if (status === "reserved") return t(lang, "Reserved", "Reservada");
  if (status === "sold") return t(lang, "Sold", "Vendida");
  if (status === "coming_soon") return t(lang, "Coming soon", "Próximamente");
  return t(lang, "Unknown", "Sin estado");
};

const amenityCategoryText = (category?: string) => {
  const normalized = String(category ?? "").toLowerCase();
  if (normalized === "wellness") return t(lang, "Wellness", "Bienestar");
  if (normalized === "kids") return t(lang, "Kids", "Niños");
  if (normalized === "parking") return t(lang, "Parking", "Aparcamiento");
  if (normalized === "green") return t(lang, "Green", "Zonas verdes");
  if (normalized === "security") return t(lang, "Security", "Seguridad");
  return t(lang, "Amenity", "Amenidad");
};
---

<BaseLayout lang={lang} title={seoTitle}>
  <Fragment slot="head">
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={seoImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={seoImage} />
    {seoNoindex && <meta name="robots" content="noindex,nofollow" />}
  </Fragment>

  <section class="space-y-5">
    <header class="space-y-2">
      <h1 class="text-3xl tracking-tight">{t(lang, "Cinematic masterplan", "Plan maestro cinemático")}</h1>
      <p class="text-sm opacity-80">{t(lang, "Tap a building to inspect live inventory.", "Toca un bloque para ver el inventario en vivo.")}</p>
    </header>

    <div class="grid gap-3 sm:grid-cols-2" id="masterplan-filters">
      <div class="space-y-1">
        <p class="text-sm font-medium">{t(lang, "Beds", "Dormitorios")}</p>
        <div class="flex flex-wrap gap-2" data-filter="beds">
          <a href="#" data-value="all" class="min-h-11 rounded-full border px-4 py-2 text-sm">{t(lang, "All", "Todos")}</a>
          <a href="#" data-value="1" class="min-h-11 rounded-full border px-4 py-2 text-sm">1</a>
          <a href="#" data-value="2" class="min-h-11 rounded-full border px-4 py-2 text-sm">2</a>
          <a href="#" data-value="3" class="min-h-11 rounded-full border px-4 py-2 text-sm">3</a>
          <a href="#" data-value="4" class="min-h-11 rounded-full border px-4 py-2 text-sm">4</a>
        </div>
      </div>
      <div class="space-y-1">
        <p class="text-sm font-medium">{t(lang, "Status", "Estado")}</p>
        <div class="flex flex-wrap gap-2" data-filter="status">
          <a href="#" data-value="all" class="min-h-11 rounded-full border px-4 py-2 text-sm">{t(lang, "All", "Todos")}</a>
          <a href="#" data-value="available" class="min-h-11 rounded-full border px-4 py-2 text-sm">{t(lang, "Available", "Disponible")}</a>
          <a href="#" data-value="reserved" class="min-h-11 rounded-full border px-4 py-2 text-sm">{t(lang, "Reserved", "Reservada")}</a>
          <a href="#" data-value="sold" class="min-h-11 rounded-full border px-4 py-2 text-sm">{t(lang, "Sold", "Vendida")}</a>
          <a href="#" data-value="coming_soon" class="min-h-11 rounded-full border px-4 py-2 text-sm">{t(lang, "Coming soon", "Próximamente")}</a>
        </div>
      </div>
    </div>

    <div class="overflow-hidden rounded-xl border">
      <div class="relative w-full pt-[56.25%]">
        {masterplanImage ? (
          <img
            src={masterplanImage}
            alt={t(lang, "Atlas masterplan", "Plan maestro Atlas")}
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
            decoding="async"
            width="1600"
            height="900"
          />
        ) : (
          <div class="absolute inset-0 bg-gradient-to-br from-slate-700 via-slate-600 to-slate-500" />
        )}

        {buildings.map((building) => {
          const id = String(building.id).toLowerCase();
          const x = Math.min(100, Math.max(0, Number(building.masterplan_hotspot_x ?? 50)));
          const y = Math.min(100, Math.max(0, Number(building.masterplan_hotspot_y ?? 50)));
          const buildingName = lang === "es" ? building.name_es : building.name_en;
          return (
            <button
              type="button"
              class="masterplan-building absolute z-10 min-h-12 min-w-12 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white bg-black/80 px-3 py-2 text-xs font-semibold text-white shadow transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-black"
              style={`left:${x}%;top:${y}%;`}
              data-building-id={id}
              aria-label={`${t(lang, "Open building", "Abrir bloque")} ${buildingName}`}
            >
              <span>{String(building.id).toUpperCase()}</span>
              <span class="ml-1" data-building-count={id}>{buildingCounts.get(id) ?? 0}</span>
            </button>
          );
        })}

        {amenities.map((amenity) => {
          const amenityId = String(amenity.id);
          const x = Math.min(100, Math.max(0, Number(amenity.x ?? 50)));
          const y = Math.min(100, Math.max(0, Number(amenity.y ?? 50)));
          return (
            <button
              type="button"
              class="masterplan-amenity absolute z-10 min-h-12 min-w-12 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white bg-white/90 px-2 py-2 text-xs font-semibold text-black shadow transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black focus-visible:ring-offset-2 focus-visible:ring-offset-white"
              style={`left:${x}%;top:${y}%;`}
              data-amenity-id={amenityId}
              aria-label={lang === "es" ? amenity.label_es : amenity.label_en}
            >
              •
            </button>
          );
        })}
      </div>
    </div>

    <div id="building-panel" class="space-y-3 overflow-hidden rounded-xl border p-4">
      <h2 id="building-name" class="text-xl font-semibold tracking-tight break-words">{t(lang, "Select a building", "Selecciona un bloque")}</h2>
      <p id="building-meta" class="text-sm opacity-80 break-words">{t(lang, "Tap a building hotspot to see details.", "Toca un hotspot para ver los detalles.")}</p>
      <dl class="grid gap-2 text-sm sm:grid-cols-2">
        <div>
          <dt class="opacity-70">{t(lang, "Available", "Disponible")}</dt>
          <dd id="status-available" class="font-medium">0</dd>
        </div>
        <div>
          <dt class="opacity-70">{t(lang, "Reserved", "Reservada")}</dt>
          <dd id="status-reserved" class="font-medium">0</dd>
        </div>
        <div>
          <dt class="opacity-70">{t(lang, "Sold", "Vendida")}</dt>
          <dd id="status-sold" class="font-medium">0</dd>
        </div>
        <div>
          <dt class="opacity-70">{t(lang, "Coming soon", "Próximamente")}</dt>
          <dd id="status-coming_soon" class="font-medium">0</dd>
        </div>
      </dl>
      <a id="view-units-link" class="inline-flex min-h-11 items-center rounded-lg bg-black px-4 py-2 font-medium text-white" href={`/${lang}/units/`}>
        {t(lang, "View units", "Ver unidades")}
      </a>
    </div>

    <div id="amenity-panel" class="space-y-1 overflow-hidden rounded-xl border p-4">
      <h3 id="amenity-name" class="text-lg font-semibold break-words">{t(lang, "Amenity", "Amenidad")}</h3>
      <p id="amenity-category" class="text-sm opacity-80 break-words">{t(lang, "Tap an amenity hotspot.", "Toca un hotspot de amenidad.")}</p>
    </div>
  </section>
</BaseLayout>

<script id="masterplan-data" type="application/json" set:html={JSON.stringify({
  lang,
  buildings: buildings.map((building) => ({
    id: String(building.id).toLowerCase(),
    name: lang === "es" ? building.name_es : building.name_en,
    floors: building.floors ?? "",
    deliveryDate: building.delivery_date ?? "",
  })),
  amenities: amenities.map((amenity) => ({
    id: String(amenity.id),
    label: lang === "es" ? amenity.label_es : amenity.label_en,
    category: amenityCategoryText(amenity.category),
  })),
  units: normalizedUnits,
  labels: {
    floors: t(lang, "Floors", "Plantas"),
    delivery: t(lang, "Delivery", "Entrega"),
    noData: t(lang, "n/a", "n/d"),
    selectBuilding: t(lang, "Select a building", "Selecciona un bloque"),
  },
})} />

<script is:inline>
  (() => {
    const dataEl = document.getElementById("masterplan-data");
    if (!dataEl) return;
    const data = JSON.parse(dataEl.textContent || "{}");

    const allowedBeds = new Set(["all", "1", "2", "3", "4"]);
    const allowedStatus = new Set(["all", "available", "reserved", "sold", "coming_soon"]);

    const params = new URLSearchParams(window.location.search);
    const filters = {
      beds: allowedBeds.has(params.get("beds") || "") ? (params.get("beds") || "all") : "all",
      status: allowedStatus.has(params.get("status") || "") ? (params.get("status") || "all") : "all",
      building: (params.get("building") || "").toLowerCase(),
    };

    const buildQuery = (next) => {
      const query = new URLSearchParams();
      if (next.beds && next.beds !== "all") query.set("beds", next.beds);
      if (next.status && next.status !== "all") query.set("status", next.status);
      if (next.building) query.set("building", next.building);
      const qs = query.toString();
      return `${window.location.pathname}${qs ? `?${qs}` : ""}`;
    };

    const updateFilterLinks = () => {
      document.querySelectorAll("[data-filter]").forEach((group) => {
        const key = group.getAttribute("data-filter");
        group.querySelectorAll("a[data-value]").forEach((link) => {
          const value = link.getAttribute("data-value") || "all";
          const next = { ...filters, [key]: value };
          link.setAttribute("href", buildQuery(next));
          const active = filters[key] === value;
          link.classList.toggle("bg-black", active);
          link.classList.toggle("text-white", active);
          link.classList.toggle("border-black", active);
        });
      });
    };

    const getFilteredUnits = () => data.units.filter((unit) => {
      const bedsMatch = filters.beds === "all" || unit.beds === filters.beds;
      const statusMatch = filters.status === "all" || unit.status === filters.status;
      return bedsMatch && statusMatch;
    });

    const updateBuildingCounts = (filteredUnits) => {
      const counts = {};
      filteredUnits.forEach((unit) => {
        counts[unit.buildingId] = (counts[unit.buildingId] || 0) + 1;
      });
      document.querySelectorAll("[data-building-count]").forEach((el) => {
        const id = el.getAttribute("data-building-count") || "";
        el.textContent = String(counts[id] || 0);
      });
    };

    const updateBuildingPanel = (buildingId, filteredUnits) => {
      const building = data.buildings.find((item) => item.id === buildingId);
      if (!building) return;

      document.getElementById("building-name").textContent = building.name;
      const floors = building.floors || data.labels.noData;
      const delivery = building.deliveryDate || data.labels.noData;
      document.getElementById("building-meta").textContent = `${data.labels.floors}: ${floors} · ${data.labels.delivery}: ${delivery}`;

      const scoped = filteredUnits.filter((unit) => unit.buildingId === buildingId);
      const statuses = { available: 0, reserved: 0, sold: 0, coming_soon: 0 };
      scoped.forEach((unit) => {
        if (Object.prototype.hasOwnProperty.call(statuses, unit.status)) statuses[unit.status] += 1;
      });
      Object.entries(statuses).forEach(([status, count]) => {
        const node = document.getElementById(`status-${status}`);
        if (node) node.textContent = String(count);
      });

      const unitsLink = document.getElementById("view-units-link");
      if (unitsLink) unitsLink.setAttribute("href", `/${data.lang}/units/${buildQuery({ ...filters, building: buildingId }).replace(window.location.pathname, "")}`);

      document.querySelectorAll(".masterplan-building").forEach((button) => {
        const active = button.getAttribute("data-building-id") === buildingId;
        button.classList.toggle("ring-2", active);
        button.classList.toggle("ring-black", active);
      });
    };

    const updateAmenityPanel = (amenityId) => {
      const amenity = data.amenities.find((item) => item.id === amenityId);
      if (!amenity) return;
      const name = document.getElementById("amenity-name");
      const category = document.getElementById("amenity-category");
      if (name) name.textContent = amenity.label;
      if (category) category.textContent = amenity.category;
    };

    const filteredUnits = getFilteredUnits();
    updateFilterLinks();
    updateBuildingCounts(filteredUnits);

    const initialBuilding = filters.building || (data.buildings[0]?.id || "");
    if (initialBuilding) updateBuildingPanel(initialBuilding, filteredUnits);

    document.querySelectorAll(".masterplan-building").forEach((button) => {
      button.addEventListener("click", () => {
        const buildingId = button.getAttribute("data-building-id") || "";
        filters.building = buildingId;
        updateBuildingPanel(buildingId, filteredUnits);
      });
    });

    document.querySelectorAll(".masterplan-amenity").forEach((button) => {
      button.addEventListener("click", () => {
        const amenityId = button.getAttribute("data-amenity-id") || "";
        updateAmenityPanel(amenityId);
      });
    });
  })();
</script>
