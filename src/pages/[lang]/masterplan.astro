---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LANGS, type Lang, isLang, t } from "../../content/languages";
import { getAmenities, getBuildings, getUnits } from "../../vertical/cms/sheets";
import { ATLAS_ASSETS } from "../../vertical/content/assets";
import SeoHead from "../../vertical/ui/SeoHead.astro";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const lang = langParam as Lang;

const searchParams = Astro.url.searchParams;
const bedsParam = searchParams.get("beds") ?? "all";
const statusParam = searchParams.get("status") ?? "all";
const initialBeds = ["all", "1", "2", "3", "4"].includes(bedsParam) ? bedsParam : "all";
const initialStatus = ["all", "available", "reserved", "sold", "coming_soon"].includes(statusParam)
  ? statusParam
  : "all";

const [buildings, amenities, units] = await Promise.all([getBuildings(), getAmenities(), getUnits()]);
const masterplanImage = String(ATLAS_ASSETS.masterplan?.mp01Wide16x9 || "/atlas/masterplan/mp-01-wide-16x9.png").trim();

const normalizedUnits = units.map((unit) => ({
  buildingId: String(unit.building_id ?? "").toLowerCase(),
  beds: String(unit.beds ?? "").toLowerCase(),
  status: String(unit.status ?? "").toLowerCase(),
}));

const filteredUnits = normalizedUnits.filter((unit) => {
  const bedsMatch = initialBeds === "all" || unit.beds === initialBeds;
  const statusMatch = initialStatus === "all" || unit.status === initialStatus;
  return bedsMatch && statusMatch;
});

const buildingCounts = new Map<string, number>();
for (const unit of filteredUnits) {
  buildingCounts.set(unit.buildingId, (buildingCounts.get(unit.buildingId) ?? 0) + 1);
}

const statusText = (status: string) => {
  if (status === "available") return t(lang, "Available", "Disponible");
  if (status === "reserved") return t(lang, "Reserved", "Reservada");
  if (status === "sold") return t(lang, "Sold", "Vendida");
  if (status === "coming_soon") return t(lang, "Coming soon", "Próximamente");
  return t(lang, "Unknown", "Sin estado");
};

const amenityCategoryText = (category?: string) => {
  const normalized = String(category ?? "").toLowerCase();
  if (normalized === "wellness") return t(lang, "Wellness", "Bienestar");
  if (normalized === "kids") return t(lang, "Kids", "Niños");
  if (normalized === "parking") return t(lang, "Parking", "Aparcamiento");
  if (normalized === "green") return t(lang, "Green", "Zonas verdes");
  if (normalized === "security") return t(lang, "Security", "Seguridad");
  return t(lang, "Amenity", "Amenidad");
};
---

<BaseLayout lang={lang}>
  <Fragment slot="head">
    <SeoHead lang={lang} page="masterplan" />
  </Fragment>

  <section class="masterplan-premium-shell" aria-labelledby="masterplan-title">
    <header class="masterplan-premium-hero">
      <div class="masterplan-premium-hero__copy">
        <p class="masterplan-premium-kicker">
          {t(lang, "Interactive masterplan", "Masterplan interactivo")}
        </p>

        <h1 id="masterplan-title" class="masterplan-premium-title">
          {t(lang, "Residence overview by tower, light and availability", "Vista residencial por torre, luz y disponibilidad")}
        </h1>

        <p class="masterplan-premium-lede">
          {t(
            lang,
            "Explore the building composition, arrival sequence, garden court and residence availability through a focused architectural stage.",
            "Explora la composición del edificio, la secuencia de llegada, el patio ajardinado y la disponibilidad residencial mediante una escena arquitectónica enfocada.",
          )}
        </p>

        <div class="masterplan-premium-signals" aria-label={t(lang, "Masterplan highlights", "Aspectos destacados del masterplan")}>
          <span>
            <strong>2</strong>
            <em>{t(lang, "residential towers", "torres residenciales")}</em>
          </span>
          <span>
            <strong>48</strong>
            <em>{t(lang, "total residences", "residencias totales")}</em>
          </span>
          <span>
            <strong>19</strong>
            <em>{t(lang, "available now", "disponibles ahora")}</em>
          </span>
        </div>
      </div>

      <aside class="masterplan-premium-hero__card" aria-label={t(lang, "Availability overview", "Resumen de disponibilidad")}>
        <p class="masterplan-premium-card-kicker">
          {t(lang, "Availability overview", "Resumen de disponibilidad")}
        </p>

        <dl class="masterplan-premium-overview">
          <div>
            <dt>{t(lang, "Tower A", "Torre A")}</dt>
            <dd>24</dd>
          </div>
          <div>
            <dt>{t(lang, "Tower B", "Torre B")}</dt>
            <dd>24</dd>
          </div>
          <div>
            <dt>{t(lang, "Available", "Disponible")}</dt>
            <dd>19</dd>
          </div>
          <div>
            <dt>{t(lang, "From", "Desde")}</dt>
            <dd>€320,000</dd>
          </div>
        </dl>

        <div class="masterplan-premium-card-actions">
          <a class="masterplan-premium-button masterplan-premium-button--primary" href={`/${lang}/units/`}>
            <span>{t(lang, "View available residences", "Ver residencias disponibles")}</span>
            <span aria-hidden="true">→</span>
          </a>

          <a class="masterplan-premium-button masterplan-premium-button--secondary" href={`/${lang}/contact/`}>
            <span>{t(lang, "Book a viewing", "Reservar visita")}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </aside>
    </header>

    <section
      class="masterplan-premium-stage-shell masterplan-premium-stage-shell--no-copy"
      aria-label={t(lang, "Interactive masterplan", "Masterplan interactivo")}
    >
      <div class="masterplan-premium-stage" data-mp-stage data-active-zone="tower-a">
        <div class="masterplan-premium-map" aria-label={t(lang, "Interactive masterplan map", "Mapa interactivo del masterplan")}>
          <img
            class="masterplan-premium-map__image"
            src={masterplanImage}
            alt={t(lang, "Atlas Residences masterplan", "Masterplan de Atlas Residences")}
            loading="eager"
            decoding="async"
          />

          <div class="masterplan-premium-map__grid" aria-hidden="true"></div>

          <div class="masterplan-premium-zone masterplan-premium-zone--tower-a" aria-hidden="true">
            <span>{t(lang, "Tower A", "Torre A")}</span>
          </div>

          <div class="masterplan-premium-zone masterplan-premium-zone--tower-b" aria-hidden="true">
            <span>{t(lang, "Tower B", "Torre B")}</span>
          </div>

          <div class="masterplan-premium-zone masterplan-premium-zone--garden" aria-hidden="true">
            <span>{t(lang, "Garden court", "Patio ajardinado")}</span>
          </div>

          <div class="masterplan-premium-zone masterplan-premium-zone--entry" aria-hidden="true">
            <span>{t(lang, "Arrival", "Llegada")}</span>
          </div>

          <div class="masterplan-premium-zone masterplan-premium-zone--amenities" aria-hidden="true">
            <span>{t(lang, "Amenities", "Servicios")}</span>
          </div>

          <button
            type="button"
            class="masterplan-premium-hotspot masterplan-premium-hotspot--tower-a is-active"
            data-zone="tower-a"
            data-title={t(lang, "Tower A", "Torre A")}
            data-kicker={t(lang, "Residential volume", "Volumen residencial")}
            data-description={t(
              lang,
              "A calm residential wing with morning light, garden proximity and a focused selection of one- and two-bedroom residences.",
              "Un ala residencial tranquila con luz de mañana, proximidad al jardín y una selección enfocada de viviendas de uno y dos dormitorios.",
            )}
            data-residences="24"
            data-available="11"
            data-focus={t(lang, "Morning light", "Luz de manana")}
            data-orientation={t(lang, "City / garden", "Ciudad / jardín")}
            aria-label={t(lang, "Select Tower A", "Seleccionar Torre A")}
          >
            <span>A</span>
          </button>

          <button
            type="button"
            class="masterplan-premium-hotspot masterplan-premium-hotspot--tower-b"
            data-zone="tower-b"
            data-title={t(lang, "Tower B", "Torre B")}
            data-kicker={t(lang, "Residential volume", "Volumen residencial")}
            data-description={t(
              lang,
              "A second residential wing oriented toward warmer evening light, upper views and a quieter internal rhythm.",
              "Una segunda ala residencial orientada hacia la luz cálida de la tarde, vistas superiores y un ritmo interior más tranquilo.",
            )}
            data-residences="24"
            data-available="8"
            data-focus={t(lang, "Sunset aspect", "Orientacion atardecer")}
            data-orientation={t(lang, "Sea / courtyard", "Mar / patio")}
            aria-label={t(lang, "Select Tower B", "Seleccionar Torre B")}
          >
            <span>B</span>
          </button>

          <button
            type="button"
            class="masterplan-premium-hotspot masterplan-premium-hotspot--garden"
            data-zone="garden"
            data-title={t(lang, "Garden court", "Patio ajardinado")}
            data-kicker={t(lang, "Landscape buffer", "Filtro paisajistico")}
            data-description={t(
              lang,
              "A planted internal court softens the arrival experience and creates a quieter threshold between residence, city and daily life.",
              "Un patio interior ajardinado suaviza la experiencia de llegada y crea un umbral más tranquilo entre residencia, ciudad y vida diaria.",
            )}
            data-residences="?"
            data-available="Shared"
            data-focus={t(lang, "Calm arrival", "Llegada tranquila")}
            data-orientation={t(lang, "Internal green", "Verde interior")}
            aria-label={t(lang, "Select garden court", "Seleccionar patio ajardinado")}
          >
            <span>G</span>
          </button>

          <button
            type="button"
            class="masterplan-premium-hotspot masterplan-premium-hotspot--entry"
            data-zone="entry"
            data-title={t(lang, "Main arrival", "Llegada principal")}
            data-kicker={t(lang, "Private access", "Acceso privado")}
            data-description={t(
              lang,
              "The arrival point is planned as a clear and quiet sequence for residents, visitors and private viewing appointments.",
              "El punto de llegada se plantea como una secuencia clara y tranquila para residentes, visitantes y visitas privadas.",
            )}
            data-residences="?"
            data-available="Access"
            data-focus={t(lang, "Drop-off", "Acceso")}
            data-orientation={t(lang, "Street / lobby", "Calle / lobby")}
            aria-label={t(lang, "Select main arrival", "Seleccionar llegada principal")}
          >
            <span>E</span>
          </button>

          <button
            type="button"
            class="masterplan-premium-hotspot masterplan-premium-hotspot--amenities"
            data-zone="amenities"
            data-title={t(lang, "Amenities level", "Nivel de servicios")}
            data-kicker={t(lang, "Shared residence layer", "Capa residencial compartida")}
            data-description={t(
              lang,
              "Shared residence services support everyday comfort, including wellness, storage and private resident functions.",
              "Los servicios residenciales compartidos apoyan la comodidad diaria, incluyendo bienestar, almacenamiento y funciones privadas para residentes.",
            )}
            data-residences="Shared"
            data-available="Resident"
            data-focus={t(lang, "Wellness / storage", "Bienestar / almacenamiento")}
            data-orientation={t(lang, "Lower level", "Nivel inferior")}
            aria-label={t(lang, "Select amenities level", "Seleccionar nivel de servicios")}
          >
            <span>+</span>
          </button>
        </div>

        <aside class="masterplan-premium-panel" aria-live="polite">
          <p class="masterplan-premium-card-kicker" data-mp-panel-kicker>
            {t(lang, "Residential volume", "Volumen residencial")}
          </p>

          <h3 data-mp-panel-title>
            {t(lang, "Tower A", "Torre A")}
          </h3>

          <p data-mp-panel-description>
            {t(
              lang,
              "A calm residential wing with morning light, garden proximity and a focused selection of one- and two-bedroom residences.",
              "Un ala residencial tranquila con luz de mañana, proximidad al jardín y una selección enfocada de viviendas de uno y dos dormitorios.",
            )}
          </p>

          <dl class="masterplan-premium-panel__facts">
            <div>
              <dt>{t(lang, "Residences", "Residencias")}</dt>
              <dd data-mp-panel-residences>24</dd>
            </div>
            <div>
              <dt>{t(lang, "Available", "Disponible")}</dt>
              <dd data-mp-panel-available>11</dd>
            </div>
            <div>
              <dt>{t(lang, "Focus", "Enfoque")}</dt>
              <dd data-mp-panel-focus>{t(lang, "Morning light", "Luz de manana")}</dd>
            </div>
            <div>
              <dt>{t(lang, "Orientation", "Orientacion")}</dt>
              <dd data-mp-panel-orientation>{t(lang, "City / garden", "Ciudad / jardín")}</dd>
            </div>
          </dl>

          <div class="masterplan-premium-panel__actions">
            <a class="masterplan-premium-button masterplan-premium-button--primary" href={`/${lang}/units/`}>
              <span>{t(lang, "Browse units", "Ver unidades")}</span>
              <span aria-hidden="true">></span>
            </a>
          </div>
        </aside>
      </div>
    </section>
    <section class="masterplan-premium-zone-rail" aria-label={t(lang, "Masterplan zones", "Zonas del masterplan")}>
      <button type="button" class="masterplan-premium-zone-button is-active" data-zone="tower-a">
        <span>{t(lang, "Tower A", "Torre A")}</span>
        <em>11 {t(lang, "available", "disponibles")}</em>
      </button>

      <button type="button" class="masterplan-premium-zone-button" data-zone="tower-b">
        <span>{t(lang, "Tower B", "Torre B")}</span>
        <em>8 {t(lang, "available", "disponibles")}</em>
      </button>

      <button type="button" class="masterplan-premium-zone-button" data-zone="garden">
        <span>{t(lang, "Garden court", "Patio ajardinado")}</span>
        <em>{t(lang, "shared calm", "calma compartida")}</em>
      </button>

      <button type="button" class="masterplan-premium-zone-button" data-zone="entry">
        <span>{t(lang, "Arrival", "Llegada")}</span>
        <em>{t(lang, "private access", "acceso privado")}</em>
      </button>

      <button type="button" class="masterplan-premium-zone-button" data-zone="amenities">
        <span>{t(lang, "Amenities", "Servicios")}</span>
        <em>{t(lang, "resident layer", "capa residencial")}</em>
      </button>
    </section>

    <footer class="masterplan-premium-cta">
      <div>
        <p class="masterplan-premium-kicker">
          {t(lang, "Next step", "Siguiente paso")}
        </p>

        <h2>
          {t(lang, "Choose a residence from the plan logic", "Elige una residencia desde la lógica del plano")}
        </h2>
      </div>

      <div class="masterplan-premium-cta__actions">
        <a class="masterplan-premium-button masterplan-premium-button--primary" href={`/${lang}/units/`}>
          <span>{t(lang, "View available residences", "Ver residencias disponibles")}</span>
          <span aria-hidden="true">→</span>
        </a>

        <a class="masterplan-premium-button masterplan-premium-button--secondary" href={`/${lang}/contact/`}>
          <span>{t(lang, "Book a private viewing", "Reservar visita privada")}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </footer>
  </section>

  <script is:inline>
  (() => {
    const root = document.querySelector(".masterplan-premium-shell");
    if (!root) return;

    const stage = root.querySelector("[data-mp-stage]");
    const hotspotButtons = Array.from(root.querySelectorAll(".masterplan-premium-hotspot"));
    const zoneButtons = Array.from(root.querySelectorAll(".masterplan-premium-zone-button"));

    const panel = {
      kicker: root.querySelector("[data-mp-panel-kicker]"),
      title: root.querySelector("[data-mp-panel-title]"),
      description: root.querySelector("[data-mp-panel-description]"),
      residences: root.querySelector("[data-mp-panel-residences]"),
      available: root.querySelector("[data-mp-panel-available]"),
      focus: root.querySelector("[data-mp-panel-focus]"),
      orientation: root.querySelector("[data-mp-panel-orientation]"),
    };

    const allControls = [...hotspotButtons, ...zoneButtons];

    const findSource = (zone) => hotspotButtons.find((button) => button.dataset.zone === zone);

    const setActiveZone = (zone) => {
      const source = findSource(zone);
      if (!source || !stage) return;

      stage.dataset.activeZone = zone;

      allControls.forEach((button) => {
        button.classList.toggle("is-active", button.dataset.zone === zone);
      });

      if (panel.kicker) panel.kicker.textContent = source.dataset.kicker || "";
      if (panel.title) panel.title.textContent = source.dataset.title || "";
      if (panel.description) panel.description.textContent = source.dataset.description || "";
      if (panel.residences) panel.residences.textContent = source.dataset.residences || "";
      if (panel.available) panel.available.textContent = source.dataset.available || "";
      if (panel.focus) panel.focus.textContent = source.dataset.focus || "";
      if (panel.orientation) panel.orientation.textContent = source.dataset.orientation || "";
    };

    allControls.forEach((button) => {
      button.addEventListener("click", () => {
        const zone = button.dataset.zone;
        if (zone) setActiveZone(zone);
      });
    });
  })();
</script>

</BaseLayout>
