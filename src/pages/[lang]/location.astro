---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LANGS, type Lang, isLang, t } from "../../content/languages";
import { getPageBySlug, getPoi, getSettings } from "../../vertical/cms/sheets";
import { ATLAS_ASSETS } from "../../vertical/content/assets";
import SeoHead from "../../vertical/ui/SeoHead.astro";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const lang = langParam as Lang;

const p0 = Astro.url.pathname;
const p = p0.endsWith("/") ? p0 : `${p0}/`;
const [settings, pageSeo, poi] = await Promise.all([getSettings(), getPageBySlug(p), getPoi()]);

const projectName = (lang === "es" ? settings.project_name_es : settings.project_name_en) || "Atlas Residences";
const defaultDescription =
  (lang === "es" ? settings.tagline_es : settings.tagline_en) ||
  t(lang, "Explore the location around Atlas Residences.", "Explora la ubicación alrededor de Atlas Residences.");

const seoTitle = (lang === "es" ? pageSeo?.title_es : pageSeo?.title_en) || `${t(lang, "Location", "Ubicación")} — ${projectName}`;
const seoDescription = (lang === "es" ? pageSeo?.description_es : pageSeo?.description_en) || defaultDescription;
const seoImage = pageSeo?.og_image || ATLAS_ASSETS.og.og01Home1200x630 || ATLAS_ASSETS.masterplan.mp01Wide16x9;
const seoNoindex = String(pageSeo?.noindex ?? "").toLowerCase() === "true";
const ogLocale = lang === "es" ? "es_ES" : "en_US";

const categoryOptions = ["all", "metro", "school", "park", "beach", "shopping", "culture"] as const;
const requestedCat = (Astro.url.searchParams.get("cat") ?? "all").toLowerCase();
const activeCat = categoryOptions.includes(requestedCat as (typeof categoryOptions)[number]) ? requestedCat : "all";

const categoryLabel = (category: string) => {
  if (category === "metro") return t(lang, "Metro", "Metro");
  if (category === "school") return t(lang, "School", "Colegio");
  if (category === "park") return t(lang, "Park", "Parque");
  if (category === "beach") return t(lang, "Beach", "Playa");
  if (category === "shopping") return t(lang, "Shopping", "Compras");
  if (category === "culture") return t(lang, "Culture", "Cultura");
  return t(lang, "Nearby", "Cercano");
};

const sortedPoi = [...poi].sort((a, b) => Number(a.distance_minutes ?? 9999) - Number(b.distance_minutes ?? 9999));
const filteredPoi = activeCat === "all" ? sortedPoi : sortedPoi.filter((item) => String(item.category ?? "").toLowerCase() === activeCat);

const buildCatHref = (category: string) => {
  if (category === "all") return p;
  const q = new URLSearchParams();
  q.set("cat", category);
  return `${p}?${q.toString()}`;
};

const address = lang === "es" ? settings.address_es : settings.address_en;
const hasProjectCoords = Boolean(settings.coords_lat && settings.coords_lng);
const projectMapsHref = hasProjectCoords
  ? `https://www.google.com/maps?q=${encodeURIComponent(`${settings.coords_lat},${settings.coords_lng}`)}`
  : "";
---

<BaseLayout lang={lang}>
  <Fragment slot="head">
    <SeoHead lang={lang} page="location" />
  </Fragment>

  <section class="location-premium-shell" aria-labelledby="location-title">
    <header class="location-premium-hero">
      <div class="location-premium-hero__copy">
        <p class="location-premium-kicker">
          {t(lang, "Barcelona residence address", "Dirección residencial en Barcelona")}
        </p>

        <h1 id="location-title" class="location-premium-title">
          {t(lang, "A quiet address connected to the city", "Una dirección tranquila conectada con la ciudad")}
        </h1>

        <p class="location-premium-lede">
          {t(
            lang,
            "Atlas Residences is presented through nearby transport, parks, culture, services and waterfront destinations — all arranged by reach time.",
            "Atlas Residences se presenta a través del transporte cercano, parques, cultura, servicios y destinos junto al agua — todo organizado por tiempo de llegada.",
          )}
        </p>

        <div class="location-premium-signals" aria-label={t(lang, "Location highlights", "Aspectos destacados de ubicación")}>
          {sortedPoi.slice(0, 4).map((item) => {
            const poiName = lang === "es" ? item.name_es : item.name_en;
            const minutes = Number(item.distance_minutes ?? 0);

            return (
              <span>
                <strong>{minutes}</strong>
                <span>{t(lang, "min", "min")}</span>
                <em>{poiName}</em>
              </span>
            );
          })}
        </div>
      </div>

      <aside class="location-premium-address-card" aria-label={t(lang, "Residence address", "Dirección de la residencia")}>
        <p class="location-premium-card-kicker">
          {t(lang, "Residence address", "Dirección de la residencia")}
        </p>

        <h2>
          {address || t(lang, "Address available soon", "Dirección disponible pronto")}
        </h2>

        <p>
          {t(
            lang,
            "A calm residential base with quick access to daily essentials, city culture and the waterfront.",
            "Una base residencial tranquila con acceso rápido a servicios diarios, cultura urbana y el frente marítimo.",
          )}
        </p>

        <div class="location-premium-address-actions">
          {projectMapsHref && (
            <a href={projectMapsHref} target="_blank" rel="noreferrer" class="location-premium-button location-premium-button--primary">
              <span>{t(lang, "View in Maps", "Ver en Maps")}</span>
              <span aria-hidden="true">→</span>
            </a>
          )}

          <a href={`/${lang}/contact/`} class="location-premium-button location-premium-button--secondary">
            <span>{t(lang, "Book a viewing", "Reservar visita")}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </aside>
    </header>

    <section class="location-premium-control" aria-label={t(lang, "Nearby categories", "Categorías cercanas")}>
      <div>
        <p class="location-premium-control__kicker">
          {t(lang, "Refine nearby places", "Filtrar lugares cercanos")}
        </p>
        <p class="location-premium-control__meta">
          {activeCat === "all"
            ? t(lang, "All categories shown", "Todas las categorías visibles")
            : t(lang, "Filtered selection", "Selección filtrada")}
        </p>
      </div>

      <div class="location-premium-filters">
        {categoryOptions.map((category) => {
          const active = activeCat === category;

          return (
            <button
              type="button"
              data-location-filter
              data-category={category}
              data-href={buildCatHref(category)}
              class={`location-premium-filter ${active ? "is-active" : ""}`}
              aria-pressed={active ? "true" : "false"}
            >
              {category === "all" ? t(lang, "All", "Todos") : categoryLabel(category)}
            </button>
          );
        })}
      </div>
    </section>

    <section
      class="location-premium-results"
      aria-label={t(lang, "Nearby places", "Lugares cercanos")}
      data-location-results
      hidden={filteredPoi.length === 0}
    >
      <div class="location-premium-results__intro">
        <p class="location-premium-kicker">
          {t(lang, "Neighbourhood rhythm", "Ritmo del entorno")}
        </p>

        <h2>
          {t(lang, "Daily reach, curated by minutes", "Alcance diario, organizado por minutos")}
        </h2>

        <p>
          {t(
            lang,
            "The list is ordered by walking or short travel proximity, helping buyers understand everyday convenience before opening a map.",
            "La lista está ordenada por proximidad a pie o trayectos cortos, ayudando a entender la comodidad diaria antes de abrir un mapa.",
          )}
        </p>
      </div>

      <ol class="location-premium-list">
        {sortedPoi.map((item, index) => {
          const poiName = lang === "es" ? item.name_es : item.name_en;
          const category = String(item.category ?? "").toLowerCase();
          const minutes = Number(item.distance_minutes ?? 0);
          const hasPoiCoords = Boolean(item.coords_lat && item.coords_lng);
          const poiMapsHref = hasPoiCoords
            ? "https://www.google.com/maps?q=" + encodeURIComponent(String(item.coords_lat) + "," + String(item.coords_lng))
            : "";
          const matchesInitialCategory = activeCat === "all" || category === activeCat;

          return (
            <li
              class="location-premium-poi"
              data-location-poi
              data-category={category}
              hidden={!matchesInitialCategory}
            >
              <div class="location-premium-poi__index">
                {String(index + 1).padStart(2, "0")}
              </div>

              <div class="location-premium-poi__body">
                <div>
                  <p class="location-premium-poi__category">
                    {categoryLabel(category)}
                  </p>

                  <h3>
                    {poiName}
                  </h3>
                </div>

                <p class="location-premium-poi__distance">
                  <strong>{minutes}</strong>
                  <span>{t(lang, "min", "min")}</span>
                </p>

                {poiMapsHref && (
                  <a href={poiMapsHref} target="_blank" rel="noreferrer" class="location-premium-poi__link">
                    {t(lang, "View on map", "Ver en mapa")}
                    <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="location-premium-empty" data-location-empty hidden={filteredPoi.length > 0}>
      <p class="location-premium-card-kicker">
        {t(lang, "Coming soon", "Próximamente")}
      </p>
      <h2>{t(lang, "Nearby highlights will be available soon.", "Los puntos de interés cercanos estarán disponibles pronto.")}</h2>
    </section>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector(".location-premium-shell");
    if (!(root instanceof HTMLElement)) return;

    const filterButtons = Array.from(root.querySelectorAll("[data-location-filter]"));
    const items = Array.from(root.querySelectorAll("[data-location-poi]"));
    const results = root.querySelector("[data-location-results]");
    const emptyState = root.querySelector("[data-location-empty]");
    const meta = root.querySelector(".location-premium-control__meta");

    if (!filterButtons.length || !items.length) return;

    const lang = document.documentElement.lang === "es" ? "es" : "en";
    const text = {
      all: { en: "All categories shown", es: "Todas las categorías visibles" },
      filtered: { en: "Filtered selection", es: "Selección filtrada" },
    };

    const isKnownCategory = (value) =>
      filterButtons.some((button) => button.getAttribute("data-category") === value);

    const normalizeCategory = (value) => {
      const next = String(value || "all").toLowerCase();
      return isKnownCategory(next) ? next : "all";
    };

    const applyCategory = (value, updateUrl = true) => {
      const category = normalizeCategory(value);
      let visibleCount = 0;

      filterButtons.forEach((button) => {
        const active = button.getAttribute("data-category") === category;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", active ? "true" : "false");
      });

      items.forEach((item) => {
        const itemCategory = String(item.getAttribute("data-category") ?? "all").toLowerCase();
        const visible = category === "all" || itemCategory === category;
        item.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      if (results instanceof HTMLElement) results.hidden = visibleCount === 0;
      if (emptyState instanceof HTMLElement) emptyState.hidden = visibleCount > 0;
      if (meta instanceof HTMLElement) meta.textContent = category === "all" ? text.all[lang] : text.filtered[lang];

      if (updateUrl) {
        const activeButton = filterButtons.find((button) => button.getAttribute("data-category") === category);
        const href = activeButton?.getAttribute("data-href");
        if (href) history.replaceState(null, "", href);
      }
    };

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        applyCategory(button.getAttribute("data-category"));
      });
    });

    applyCategory(new URLSearchParams(window.location.search).get("cat"), false);
  })();
</script>
