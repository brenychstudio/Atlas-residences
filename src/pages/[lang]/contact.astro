---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LANGS, type Lang, isLang, t } from "../../content/languages";
import { getPageBySlug, getSettings } from "../../vertical/cms/sheets";
import { ATLAS_ASSETS } from "../../vertical/content/assets";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const lang = langParam as Lang;

const settings = await getSettings();

const p0 = Astro.url.pathname;
const p = p0.endsWith("/") ? p0 : `${p0}/`;
const pageSeo = await getPageBySlug(p);

const projectName = (lang === "es" ? settings.project_name_es : settings.project_name_en) || "Atlas Residences";
const defaultDescription =
  (lang === "es" ? settings.tagline_es : settings.tagline_en) ||
  t(lang, "Book a viewing and contact Atlas Residences.", "Reserva una visita y contacta con Atlas Residences.");

const seoTitle = (lang === "es" ? pageSeo?.title_es : pageSeo?.title_en) || `${t(lang, "Contact", "Contacto")} — ${projectName}`;
const seoDescription = (lang === "es" ? pageSeo?.description_es : pageSeo?.description_en) || defaultDescription;
const seoImage = pageSeo?.og_image || ATLAS_ASSETS.og.og01Home1200x630 || ATLAS_ASSETS.masterplan.mp01Wide16x9;
const seoNoindex = String(pageSeo?.noindex ?? "").toLowerCase() === "true";
const ogLocale = lang === "es" ? "es_ES" : "en_US";

const rawIntent = (Astro.url.searchParams.get("intent") ?? "viewing").toLowerCase();
const intent = ["viewing", "whatsapp", "call"].includes(rawIntent) ? rawIntent : "viewing";
const sourceParam = (Astro.url.searchParams.get("source") ?? "").trim().toLowerCase();
const source = ["home", "masterplan", "unit", "downloads"].includes(sourceParam) ? sourceParam : "";
const building = (Astro.url.searchParams.get("building") ?? "").trim();
const unit = (Astro.url.searchParams.get("unit") ?? "").trim();
const normalizedSource = source || "direct";
const normalizedBuilding = building;
const normalizedUnit = unit;
const normalizedIntent =
  normalizedSource === "unit" && normalizedUnit
    ? "unit_inquiry"
    : normalizedSource === "masterplan" && normalizedBuilding
      ? "building_inquiry"
      : normalizedSource === "downloads"
        ? "downloads_request"
        : normalizedSource === "home"
          ? "homepage_inquiry"
          : "sales_inquiry";
const leadContext = [
  `source=${normalizedSource}`,
  `intent=${normalizedIntent}`,
  normalizedBuilding ? `building=${normalizedBuilding}` : "",
  normalizedUnit ? `unit=${normalizedUnit}` : "",
]
  .filter(Boolean)
  .join(" | ");
const utmSource = (Astro.url.searchParams.get("utm_source") ?? "").trim();
const utmMedium = (Astro.url.searchParams.get("utm_medium") ?? "").trim();
const utmCampaign = (Astro.url.searchParams.get("utm_campaign") ?? "").trim();
const utmTerm = (Astro.url.searchParams.get("utm_term") ?? "").trim();
const utmContent = (Astro.url.searchParams.get("utm_content") ?? "").trim();
const gclid = (Astro.url.searchParams.get("gclid") ?? "").trim();
const fbclid = (Astro.url.searchParams.get("fbclid") ?? "").trim();
const page = Astro.url.pathname;
const sent = Astro.url.searchParams.get("sent") === "1";
const error = Astro.url.searchParams.get("error") === "1";
const analyticsContext = {
  ...(source ? { source } : {}),
  ...(building ? { building } : {}),
  ...(unit ? { unit } : {}),
  lang,
  page,
  ...(utmSource ? { utm_source: utmSource } : {}),
  ...(utmMedium ? { utm_medium: utmMedium } : {}),
  ...(utmCampaign ? { utm_campaign: utmCampaign } : {}),
  ...(utmTerm ? { utm_term: utmTerm } : {}),
  ...(utmContent ? { utm_content: utmContent } : {}),
  ...(gclid ? { gclid } : {}),
  ...(fbclid ? { fbclid } : {}),
};

const formAction = (import.meta.env.PUBLIC_CONTACT_FORM_ACTION ?? "").trim();
const formMethod = (import.meta.env.PUBLIC_CONTACT_FORM_METHOD ?? "POST").trim() || "POST";
const siteUrlRaw = import.meta.env.PUBLIC_SITE_URL;
const siteOrigin = siteUrlRaw && String(siteUrlRaw).trim() ? String(siteUrlRaw).trim().replace(/\/+$/, "") : "";
const hasFormAction = Boolean(formAction);
const isFormspreeCompatible = hasFormAction && formAction.toLowerCase().includes("formspree.io");
const contactSentPath = `/${lang}/contact/?sent=1`;
const formspreeNext = siteOrigin ? `${siteOrigin}${contactSentPath}` : contactSentPath;
const formspreeSubject = ["Atlas Residences lead", normalizedSource ? `source=${normalizedSource}` : "", normalizedBuilding ? `building=${normalizedBuilding}` : "", normalizedUnit ? `unit=${normalizedUnit}` : ""]
  .filter(Boolean)
  .join(" · ");

const contextMessage =
  source === "masterplan" && building
    ? t(lang, `Request a viewing for Tower ${building.toUpperCase()}.`, `Solicita una visita para la Torre ${building.toUpperCase()}.`)
    : source === "unit" && unit
      ? t(lang, `Request details or a viewing for unit ${unit.toUpperCase()}.`, `Solicita detalles o una visita para la unidad ${unit.toUpperCase()}.`)
      : source === "home"
        ? t(lang, "Request a viewing or sales consultation.", "Solicita una visita o asesoría comercial.")
        : source === "masterplan"
          ? t(lang, "Request a viewing from the masterplan.", "Solicita una visita desde el plan maestro.")
          : source === "unit"
            ? t(lang, "Request details or a viewing for this unit.", "Solicita detalles o una visita para esta unidad.")
            : source === "downloads"
              ? t(lang, "Get help with brochures, pricing, and downloadable materials.", "Recibe ayuda con folletos, precios y material descargable.")
              : "";

const phone = settings.phone ?? "";
const whatsappRaw = (settings.whatsapp ?? "").replace(/[^\d+]/g, "");
const whatsappPhone = whatsappRaw.replace(/^\+/, "");
const email = settings.email ?? "";
const address = lang === "es" ? settings.address_es ?? "" : settings.address_en ?? "";

const waMessage =
  intent === "whatsapp"
    ? t(lang, "Hi, I want to chat on WhatsApp about Atlas Residences.", "Hola, quiero contactar por WhatsApp sobre Atlas Residences.")
    : t(lang, "Hi, I want to book a viewing at Atlas Residences.", "Hola, quiero reservar una visita en Atlas Residences.");

const whatsappHref = whatsappPhone ? `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(waMessage)}` : "";
const callHref = phone ? `tel:${phone}` : "";
const emailHref = email ? `mailto:${email}` : "";

const hasCoords = Boolean(settings.coords_lat && settings.coords_lng);
const mapsHref = hasCoords
  ? `https://www.google.com/maps?q=${encodeURIComponent(`${settings.coords_lat},${settings.coords_lng}`)}`
  : "";

const sourceContext =
  source === "home"
    ? t(lang, "from the homepage", "desde la página principal")
    : source === "masterplan"
      ? t(lang, "from the masterplan", "desde el plan maestro")
      : source === "unit"
        ? t(lang, "from a unit inquiry", "desde una consulta de unidad")
        : source === "downloads"
          ? t(lang, "from downloads", "desde descargas")
          : "";

const selectionSummary = [
  building ? `${t(lang, "Tower", "Torre")} ${building.toUpperCase()}` : "",
  unit ? `${t(lang, "Unit", "Unidad")} ${unit.toUpperCase()}` : "",
]
  .filter(Boolean)
  .join(" • ");
---

<BaseLayout lang={lang} title={seoTitle}>
  <Fragment slot="head">
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={seoImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={seoImage} />
    {seoNoindex && <meta name="robots" content="noindex,nofollow" />}
  </Fragment>

  <section class="contact-premium-shell" aria-labelledby="contact-title">
    <header class="contact-premium-hero">
      <div class="contact-premium-hero__copy">
        <p class="contact-premium-kicker">
          {t(lang, "Private viewing", "Visita privada")}
        </p>

        <h1 id="contact-title" class="contact-premium-title">
          {t(lang, "Book a private viewing", "Reserva una visita privada")}
        </h1>

        <p class="contact-premium-lede">
          {t(
            lang,
            "Share your preferred contact route, language and viewing request. The sales team can follow up with availability, documents and next steps.",
            "Comparte tu vía de contacto preferida, idioma y solicitud de visita. El equipo comercial podrá responder con disponibilidad, documentos y próximos pasos.",
          )}
        </p>

        <div class="contact-premium-signals" aria-label={t(lang, "Contact options", "Opciones de contacto")}>
          <span>
            <strong>3</strong>
            <em>{t(lang, "contact routes", "vías de contacto")}</em>
          </span>
          <span>
            <strong>EN / ES</strong>
            <em>{t(lang, "language support", "idiomas disponibles")}</em>
          </span>
          <span>
            <strong>Private</strong>
            <em>{t(lang, "viewing request", "solicitud de visita")}</em>
          </span>
        </div>
      </div>

      <aside class="contact-premium-gallery-card" aria-label={t(lang, "Sales gallery", "Galería de ventas")}>
        <p class="contact-premium-card-kicker">
          {t(lang, "Sales gallery", "Galería de ventas")}
        </p>

        <h2>
          {t(lang, "Carrer de la Marina, Barcelona", "Carrer de la Marina, Barcelona")}
        </h2>

        <p>
          {t(
            lang,
            "Arrange a visit, request current availability or review the residence material with the sales team.",
            "Organiza una visita, solicita la disponibilidad actual o revisa el material residencial con el equipo comercial.",
          )}
        </p>

        <div class="contact-premium-gallery-actions">
          <a
            class="contact-premium-button contact-premium-button--primary"
            href="https://www.google.com/maps/search/?api=1&query=Carrer%20de%20la%20Marina%2C%20Barcelona"
            target="_blank"
            rel="noreferrer"
          >
            <span>{t(lang, "Open in Maps", "Abrir en Maps")}</span>
            <span aria-hidden="true">→</span>
          </a>

          <a class="contact-premium-button contact-premium-button--secondary" href={`/${lang}/downloads/`}>
            <span>{t(lang, "View documents", "Ver documentos")}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </aside>
    </header>

    <nav class="contact-premium-methods" aria-label={t(lang, "Preferred contact method", "Método de contacto preferido")}>
      <a href="#contact-form" class="contact-premium-method">
        <span>{t(lang, "WhatsApp", "WhatsApp")}</span>
        <em>{t(lang, "Fast follow-up", "Respuesta rápida")}</em>
      </a>

      <a href="#contact-form" class="contact-premium-method">
        <span>{t(lang, "Call", "Llamada")}</span>
        <em>{t(lang, "Sales team", "Equipo comercial")}</em>
      </a>

      <a href="#contact-form" class="contact-premium-method">
        <span>{t(lang, "Email", "Email")}</span>
        <em>{t(lang, "Detailed request", "Solicitud detallada")}</em>
      </a>
    </nav>

    <section class="contact-premium-form-shell" aria-labelledby="contact-form-title">
      <aside class="contact-premium-form-intro">
        <p class="contact-premium-kicker">
          {t(lang, "Request details", "Detalles de la solicitud")}
        </p>

        <h2 id="contact-form-title">
          {t(lang, "Tell us how to reach you", "Indícanos cómo contactarte")}
        </h2>

        <p>
          {t(
            lang,
            "The form is prepared as a sales request preview. Connect your preferred backend, CRM or email route when the project moves from demo to production.",
            "El formulario está preparado como vista previa de solicitud comercial. Conecta tu backend, CRM o ruta de email cuando el proyecto pase de demo a producción.",
          )}
        </p>

        <div class="contact-premium-note">
          {t(
            lang,
            "Contact routing is not connected yet. You can still review this form preview.",
            "El envío del formulario aún no está conectado. Puedes revisar esta vista previa.",
          )}
        </div>
      </aside>

      <form id="contact-form" class="contact-premium-form">
        <div class="contact-premium-fields">
          <label class="contact-premium-field">
            <span>{t(lang, "Name", "Nombre")} *</span>
            <input type="text" name="name" autocomplete="name" required />
          </label>

          <label class="contact-premium-field">
            <span>{t(lang, "Email", "Email")} *</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>

          <label class="contact-premium-field">
            <span>{t(lang, "Phone", "Teléfono")}</span>
            <input type="tel" name="phone" autocomplete="tel" />
          </label>

          <label class="contact-premium-field">
            <span>{t(lang, "Preferred language", "Idioma preferido")}</span>
            <select name="language">
              <option value="en">EN</option>
              <option value="es">ES</option>
            </select>
          </label>

          <label class="contact-premium-field contact-premium-field--full">
            <span>{t(lang, "Message", "Mensaje")} *</span>
            <textarea name="message" rows="5" required>{t(lang, "I would like to arrange a private viewing.", "Me gustaría organizar una visita privada.")}</textarea>
          </label>
        </div>

        <label class="contact-premium-consent">
          <input type="checkbox" name="consent" required />
          <span>
            {t(
              lang,
              "I agree to be contacted regarding this request.",
              "Acepto ser contactado en relación con esta solicitud.",
            )} *
          </span>
        </label>

        <div class="contact-premium-submit-row">
          <button type="submit" class="contact-premium-submit">
            <span>{t(lang, "Submit request", "Enviar solicitud")}</span>
            <span aria-hidden="true">→</span>
          </button>

          <p>
            {t(
              lang,
              "Private sales request · Atlas Residences",
              "Solicitud comercial privada · Atlas Residences",
            )}
          </p>
        </div>
      </form>
    </section>
  </section>
</BaseLayout>
