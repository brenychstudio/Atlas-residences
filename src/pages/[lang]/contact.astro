---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LANGS, type Lang, isLang, t } from "../../content/languages";
import { getPageBySlug, getSettings } from "../../vertical/cms/sheets";
import { ATLAS_ASSETS } from "../../vertical/content/assets";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const lang = langParam as Lang;

const settings = await getSettings();

const p0 = Astro.url.pathname;
const p = p0.endsWith("/") ? p0 : `${p0}/`;
const pageSeo = await getPageBySlug(p);

const projectName = (lang === "es" ? settings.project_name_es : settings.project_name_en) || "Atlas Residences";
const defaultDescription =
  (lang === "es" ? settings.tagline_es : settings.tagline_en) ||
  t(lang, "Book a viewing and contact Atlas Residences.", "Reserva una visita y contacta con Atlas Residences.");

const seoTitle = (lang === "es" ? pageSeo?.title_es : pageSeo?.title_en) || `${t(lang, "Contact", "Contacto")} — ${projectName}`;
const seoDescription = (lang === "es" ? pageSeo?.description_es : pageSeo?.description_en) || defaultDescription;
const seoImage = pageSeo?.og_image || ATLAS_ASSETS.og.og01Home1200x630 || ATLAS_ASSETS.masterplan.mp01Wide16x9;
const seoNoindex = String(pageSeo?.noindex ?? "").toLowerCase() === "true";
const ogLocale = lang === "es" ? "es_ES" : "en_US";

const rawIntent = (Astro.url.searchParams.get("intent") ?? "viewing").toLowerCase();
const intent = ["viewing", "whatsapp", "call"].includes(rawIntent) ? rawIntent : "viewing";
const sourceParam = (Astro.url.searchParams.get("source") ?? "").trim().toLowerCase();
const source = ["home", "masterplan", "unit", "downloads"].includes(sourceParam) ? sourceParam : "";
const building = (Astro.url.searchParams.get("building") ?? "").trim();
const unit = (Astro.url.searchParams.get("unit") ?? "").trim();
const normalizedSource = source || "direct";
const normalizedBuilding = building;
const normalizedUnit = unit;
const normalizedIntent =
  normalizedSource === "unit" && normalizedUnit
    ? "unit_inquiry"
    : normalizedSource === "masterplan" && normalizedBuilding
      ? "building_inquiry"
      : normalizedSource === "downloads"
        ? "downloads_request"
        : normalizedSource === "home"
          ? "homepage_inquiry"
          : "sales_inquiry";
const leadContext = [
  `source=${normalizedSource}`,
  `intent=${normalizedIntent}`,
  normalizedBuilding ? `building=${normalizedBuilding}` : "",
  normalizedUnit ? `unit=${normalizedUnit}` : "",
]
  .filter(Boolean)
  .join(" | ");
const utmSource = (Astro.url.searchParams.get("utm_source") ?? "").trim();
const utmMedium = (Astro.url.searchParams.get("utm_medium") ?? "").trim();
const utmCampaign = (Astro.url.searchParams.get("utm_campaign") ?? "").trim();
const utmTerm = (Astro.url.searchParams.get("utm_term") ?? "").trim();
const utmContent = (Astro.url.searchParams.get("utm_content") ?? "").trim();
const gclid = (Astro.url.searchParams.get("gclid") ?? "").trim();
const fbclid = (Astro.url.searchParams.get("fbclid") ?? "").trim();
const page = Astro.url.pathname;
const sent = Astro.url.searchParams.get("sent") === "1";
const error = Astro.url.searchParams.get("error") === "1";
const analyticsContext = {
  ...(source ? { source } : {}),
  ...(building ? { building } : {}),
  ...(unit ? { unit } : {}),
  lang,
  page,
  ...(utmSource ? { utm_source: utmSource } : {}),
  ...(utmMedium ? { utm_medium: utmMedium } : {}),
  ...(utmCampaign ? { utm_campaign: utmCampaign } : {}),
  ...(utmTerm ? { utm_term: utmTerm } : {}),
  ...(utmContent ? { utm_content: utmContent } : {}),
  ...(gclid ? { gclid } : {}),
  ...(fbclid ? { fbclid } : {}),
};

const formAction = (import.meta.env.PUBLIC_CONTACT_FORM_ACTION ?? "").trim();
const formMethod = (import.meta.env.PUBLIC_CONTACT_FORM_METHOD ?? "POST").trim() || "POST";
const siteUrlRaw = import.meta.env.PUBLIC_SITE_URL;
const siteOrigin = siteUrlRaw && String(siteUrlRaw).trim() ? String(siteUrlRaw).trim().replace(/\/+$/, "") : "";
const hasFormAction = Boolean(formAction);
const isFormspreeCompatible = hasFormAction && formAction.toLowerCase().includes("formspree.io");
const contactSentPath = `/${lang}/contact/?sent=1`;
const formspreeNext = siteOrigin ? `${siteOrigin}${contactSentPath}` : contactSentPath;
const formspreeSubject = ["Atlas Residences lead", normalizedSource ? `source=${normalizedSource}` : "", normalizedBuilding ? `building=${normalizedBuilding}` : "", normalizedUnit ? `unit=${normalizedUnit}` : ""]
  .filter(Boolean)
  .join(" · ");

const contextMessage =
  source === "masterplan" && building
    ? t(lang, `Request a viewing for Tower ${building.toUpperCase()}.`, `Solicita una visita para la Torre ${building.toUpperCase()}.`)
    : source === "unit" && unit
      ? t(lang, `Request details or a viewing for unit ${unit.toUpperCase()}.`, `Solicita detalles o una visita para la unidad ${unit.toUpperCase()}.`)
      : source === "home"
        ? t(lang, "Request a viewing or sales consultation.", "Solicita una visita o asesoría comercial.")
        : source === "masterplan"
          ? t(lang, "Request a viewing from the masterplan.", "Solicita una visita desde el plan maestro.")
        : source === "unit"
          ? t(lang, "Request details or a viewing for this unit.", "Solicita detalles o una visita para esta unidad.")
          : source === "downloads"
            ? t(lang, "Get help with brochures, pricing, and downloadable materials.", "Recibe ayuda con folletos, precios y material descargable.")
            : "";

const phone = settings.phone ?? "";
const whatsappRaw = (settings.whatsapp ?? "").replace(/[^\d+]/g, "");
const whatsappPhone = whatsappRaw.replace(/^\+/, "");
const email = settings.email ?? "";
const address = lang === "es" ? settings.address_es ?? "" : settings.address_en ?? "";

const waMessage =
  intent === "whatsapp"
    ? t(lang, "Hi, I want to chat on WhatsApp about Atlas Residences.", "Hola, quiero contactar por WhatsApp sobre Atlas Residences.")
    : t(lang, "Hi, I want to book a viewing at Atlas Residences.", "Hola, quiero reservar una visita en Atlas Residences.");

const whatsappHref = whatsappPhone ? `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(waMessage)}` : "";
const callHref = phone ? `tel:${phone}` : "";
const emailHref = email ? `mailto:${email}` : "";

const hasCoords = Boolean(settings.coords_lat && settings.coords_lng);
const mapsHref = hasCoords
  ? `https://www.google.com/maps?q=${encodeURIComponent(`${settings.coords_lat},${settings.coords_lng}`)}`
  : "";

const sourceContext =
  source === "home"
    ? t(lang, "from the homepage", "desde la página principal")
    : source === "masterplan"
      ? t(lang, "from the masterplan", "desde el plan maestro")
      : source === "unit"
        ? t(lang, "from a unit inquiry", "desde una consulta de unidad")
        : source === "downloads"
          ? t(lang, "from downloads", "desde descargas")
          : "";

const selectionSummary = [
  building ? `${t(lang, "Tower", "Torre")} ${building.toUpperCase()}` : "",
  unit ? `${t(lang, "Unit", "Unidad")} ${unit.toUpperCase()}` : "",
]
  .filter(Boolean)
  .join(" • ");
---

<BaseLayout lang={lang} title={seoTitle}>
  <Fragment slot="head">
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={seoImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={seoImage} />
    {seoNoindex && <meta name="robots" content="noindex,nofollow" />}
  </Fragment>

  <section class="space-y-5 sm:space-y-6">
    <header class="space-y-2.5">
      <h1 class="text-3xl tracking-tight">{t(lang, "Book a viewing", "Reservar visita")}</h1>
      <p class="max-w-2xl text-sm opacity-80">
        {t(lang, "Share your details and our team will contact you shortly.", "Comparte tus datos y nuestro equipo te contactará en breve.")}
      </p>
    </header>

    <div class="contact-cta-row cta-cluster grid gap-2 sm:grid-cols-3 sm:gap-2.5 sm:items-stretch">
      {whatsappHref ? (
        <a
          href={whatsappHref}
          target="_blank"
          rel="noreferrer"
          class={`cta-tertiary inline-flex min-h-11 items-center justify-center rounded-lg px-4 py-3 text-sm font-medium ${intent === "whatsapp" ? "is-active" : ""}`}
        >
          {t(lang, "WhatsApp", "WhatsApp")}
        </a>
      ) : (
        <span class="cta-tertiary is-disabled inline-flex min-h-11 items-center justify-center rounded-lg px-4 py-3 text-sm opacity-50">{t(lang, "WhatsApp unavailable", "WhatsApp no disponible")}</span>
      )}

      {callHref ? (
        <a
          href={callHref}
          class={`cta-tertiary inline-flex min-h-11 items-center justify-center rounded-lg px-4 py-3 text-sm font-medium ${intent === "call" ? "is-active" : ""}`}
        >
          {t(lang, "Call", "Llamar")}
        </a>
      ) : (
        <span class="cta-tertiary is-disabled inline-flex min-h-11 items-center justify-center rounded-lg px-4 py-3 text-sm opacity-50">{t(lang, "Call unavailable", "Llamada no disponible")}</span>
      )}

      {emailHref ? (
        <a href={emailHref} class="cta-tertiary inline-flex min-h-11 items-center justify-center rounded-lg px-4 py-3 text-sm font-medium">
          {t(lang, "Email", "Email")}
        </a>
      ) : (
        <span class="cta-tertiary is-disabled inline-flex min-h-11 items-center justify-center rounded-lg px-4 py-3 text-sm opacity-50">{t(lang, "Email unavailable", "Email no disponible")}</span>
      )}
    </div>

    <div class="contact-panel rounded-xl border p-4 space-y-3 sm:p-5">
      <h2 class="text-lg font-semibold">{t(lang, "Address", "Dirección")}</h2>
      <p class="text-sm opacity-80">{address || t(lang, "Address not available", "Dirección no disponible")}</p>
      {mapsHref && (
        <a href={mapsHref} target="_blank" rel="noreferrer" class="ui-btn cta-secondary inline-flex items-center text-sm">
          {t(lang, "Open in Maps", "Abrir en Maps")}
        </a>
      )}
    </div>

    {contextMessage && (
      <p class="contact-panel rounded-xl border px-4 py-4 text-sm opacity-90 sm:px-5">{contextMessage}</p>
    )}

    <div id="contact-sent-notice" class={`contact-status rounded-2xl border bg-neutral-50/60 p-5 md:p-6 space-y-3.5 ${sent ? "" : "hidden"}`} role="status" aria-live="polite">
        <div class="space-y-1.5">
          <p class="inline-flex items-center rounded-full border px-3 py-1 text-[11px] font-medium uppercase tracking-[0.14em] opacity-80">
            {t(lang, "Confirmation", "Confirmación")}
          </p>
          <h2 class="text-lg font-semibold md:text-xl">{t(lang, "Your request has been received", "Hemos recibido tu solicitud")}</h2>
          <p class="text-sm leading-relaxed opacity-80">
            {t(lang, "Thank you for your interest in Atlas Residences. A sales advisor will follow up shortly with the next steps.", "Gracias por tu interés en Atlas Residences. Un asesor comercial te contactará en breve con los próximos pasos.")}
          </p>
        </div>

        <div id="contact-sent-details" class={`rounded-xl border bg-white/80 px-3 py-2.5 text-xs space-y-1.5 ${(source || building || unit) ? "" : "hidden"}`}>
            <p class="font-medium uppercase tracking-[0.08em] opacity-70">{t(lang, "Inquiry details", "Detalles de la consulta")}</p>
            <dl class="space-y-1">
                <div id="contact-sent-source-row" class={`flex items-center justify-between gap-2 ${source ? "" : "hidden"}`}>
                  <dt class="opacity-60">{t(lang, "Source", "Origen")}</dt>
                  <dd id="contact-sent-source" class="font-medium uppercase">{source}</dd>
                </div>
                <div id="contact-sent-building-row" class={`flex items-center justify-between gap-2 ${building ? "" : "hidden"}`}>
                  <dt class="opacity-60">{t(lang, "Tower", "Torre")}</dt>
                  <dd id="contact-sent-building" class="font-medium uppercase">{building}</dd>
                </div>
                <div id="contact-sent-unit-row" class={`flex items-center justify-between gap-2 ${unit ? "" : "hidden"}`}>
                  <dt class="opacity-60">{t(lang, "Unit", "Unidad")}</dt>
                  <dd id="contact-sent-unit" class="font-medium uppercase">{unit}</dd>
                </div>
            </dl>
          </div>
      </div>

    <div id="contact-error-notice" class={`contact-status rounded-xl border px-5 py-4 space-y-1 ${error ? "" : "hidden"}`} role="alert">
        <p class="text-sm font-medium">{t(lang, "We couldn’t send your request", "No pudimos enviar tu solicitud")}</p>
        <p class="text-sm opacity-80">
          {t(lang, "Please try again in a moment, or contact us directly by WhatsApp, phone, or email.", "Por favor, inténtalo de nuevo en un momento, o contáctanos directamente por WhatsApp, llamada o email.")}
        </p>
      </div>

    {!hasFormAction && (
      <p class="contact-status rounded-xl border px-5 py-4 text-sm opacity-80">
        {t(lang, "Contact routing is not connected yet. You can still review the form in this demo.", "El enrutamiento de contacto aún no está conectado. Puedes revisar el formulario en esta demo.")}
      </p>
    )}

    <form id="contact-form" class="contact-panel space-y-4 rounded-xl border p-4 sm:p-5 md:p-6" action={hasFormAction ? formAction : undefined} method={hasFormAction ? formMethod : undefined}>
      <input type="hidden" name="intent" value={normalizedIntent} />
      <input type="hidden" name="source" value={source} />
      <input type="hidden" name="building" value={building} />
      <input type="hidden" name="unit" value={unit} />
      <input type="hidden" name="lead_context" value={leadContext} />
      <input type="hidden" name="lang" value={lang} />
      <input type="hidden" name="page" value={page} />
      {utmSource && <input type="hidden" name="utm_source" value={utmSource} data-attribution="true" />}
      {utmMedium && <input type="hidden" name="utm_medium" value={utmMedium} data-attribution="true" />}
      {utmCampaign && <input type="hidden" name="utm_campaign" value={utmCampaign} data-attribution="true" />}
      {utmTerm && <input type="hidden" name="utm_term" value={utmTerm} data-attribution="true" />}
      {utmContent && <input type="hidden" name="utm_content" value={utmContent} data-attribution="true" />}
      {gclid && <input type="hidden" name="gclid" value={gclid} data-attribution="true" />}
      {fbclid && <input type="hidden" name="fbclid" value={fbclid} data-attribution="true" />}
      {isFormspreeCompatible && (
        <>
          <input type="hidden" name="_subject" value={formspreeSubject} data-formspree-subject="true" />
          <input type="hidden" name="_next" value={formspreeNext} />
          <input type="text" name="_gotcha" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />
        </>
      )}
      <div class="contact-form-grid grid gap-3 md:grid-cols-2 md:gap-3.5">
        <label class="grid gap-1.5 text-sm">
          <span>{t(lang, "Name", "Nombre")} *</span>
          <input name="name" required class="min-h-11 w-full rounded-lg border px-3 ui-field" autocomplete="name" />
        </label>

        <label class="grid gap-1.5 text-sm">
          <span>{t(lang, "Email", "Correo")} *</span>
          <input name="email" type="email" required class="min-h-11 w-full rounded-lg border px-3 ui-field" autocomplete="email" inputmode="email" />
        </label>

        <label class="grid gap-1.5 text-sm">
          <span>{t(lang, "Phone", "Teléfono")}</span>
          <input name="phone" type="tel" class="min-h-11 w-full rounded-lg border px-3 ui-field" autocomplete="tel" inputmode="tel" />
        </label>

        <label class="grid gap-1.5 text-sm">
          <span>{t(lang, "Preferred language", "Idioma preferido")}</span>
          <select name="preferred_language" class="min-h-11 w-full rounded-lg border px-3 ui-field">
            <option value={lang}>{lang.toUpperCase()}</option>
            <option value={lang === "en" ? "es" : "en"}>{lang === "en" ? "ES" : "EN"}</option>
          </select>
        </label>
      </div>

      <label class="grid gap-1.5 text-sm">
        <span>{t(lang, "Message", "Mensaje")} *</span>
        <textarea
          name="message"
          rows={4}
          required
          minlength={10}
          maxlength={2000}
          class="w-full rounded-lg border px-3 py-2 ui-field"
          placeholder={
            intent === "call"
              ? t(lang, "Please call me back to arrange a viewing.", "Por favor, llámenme para organizar una visita.")
              : intent === "whatsapp"
                ? t(lang, "I prefer to continue on WhatsApp.", "Prefiero continuar por WhatsApp.")
                : t(lang, "I am interested in booking a viewing.", "Estoy interesado en reservar una visita.")
          }
        />
      </label>

      <label class="sr-only" aria-hidden="true">
        Company
        <input name="company" tabindex="-1" autocomplete="off" />
      </label>

      <label class="flex items-start gap-2 text-sm leading-relaxed">
        <input name="consent" type="checkbox" required class="mt-1 h-4 w-4" />
        <span>{t(lang, "I agree to be contacted about this request.", "Acepto ser contactado sobre esta solicitud.")} *</span>
      </label>

      <button type={hasFormAction ? "submit" : "button"} class="ui-btn ui-btn--primary cta-primary inline-flex w-full items-center justify-center sm:w-auto">
        {t(lang, "Send request", "Enviar solicitud")}
      </button>
    </form>

    <script>
      (() => {
        const params = new URLSearchParams(window.location.search);
        const form = document.getElementById("contact-form");
        if (!form) return;

        const allowedSources = new Set(["home", "masterplan", "unit", "downloads"]);
        const source = (params.get("source") || "").trim().toLowerCase();
        const building = (params.get("building") || "").trim();
        const unit = (params.get("unit") || "").trim();
        const cleanSource = allowedSources.has(source) ? source : "";
        const normalizedSource = cleanSource || "direct";
        const normalizedIntent =
          normalizedSource === "unit" && unit
            ? "unit_inquiry"
            : normalizedSource === "masterplan" && building
              ? "building_inquiry"
              : normalizedSource === "downloads"
                ? "downloads_request"
                : normalizedSource === "home"
                  ? "homepage_inquiry"
                  : "sales_inquiry";
        const leadContext = [
          `source=${normalizedSource}`,
          `intent=${normalizedIntent}`,
          building ? `building=${building}` : "",
          unit ? `unit=${unit}` : "",
        ]
          .filter(Boolean)
          .join(" | ");

        const setHidden = (name, value) => {
          const input = form.querySelector(`input[name="${name}"]`);
          if (input) input.value = value;
        };

        setHidden("intent", normalizedIntent);
        setHidden("source", cleanSource);
        setHidden("building", building);
        setHidden("unit", unit);
        setHidden("lead_context", leadContext);
        setHidden("page", window.location.pathname);

        ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content", "gclid", "fbclid"].forEach((name) => {
          const value = (params.get(name) || "").trim();
          let input = form.querySelector(`input[name="${name}"]`);
          if (!value) {
            input?.remove();
            return;
          }
          if (!input) {
            input = document.createElement("input");
            input.type = "hidden";
            input.name = name;
            input.setAttribute("data-attribution", "true");
            form.prepend(input);
          }
          input.value = value;
        });

        const subjectInput = form.querySelector("input[data-formspree-subject='true']");
        if (subjectInput) {
          const subjectParts = ["Atlas Residences lead", `source=${normalizedSource}`, building ? `building=${building}` : "", unit ? `unit=${unit}` : ""];
          subjectInput.value = subjectParts.filter(Boolean).join(" · ");
        }

        const sent = params.get("sent") === "1";
        const error = params.get("error") === "1";
        const sentNotice = document.getElementById("contact-sent-notice");
        const errorNotice = document.getElementById("contact-error-notice");
        sentNotice?.classList.toggle("hidden", !sent);
        errorNotice?.classList.toggle("hidden", !error);

        const details = document.getElementById("contact-sent-details");
        const sourceRow = document.getElementById("contact-sent-source-row");
        const buildingRow = document.getElementById("contact-sent-building-row");
        const unitRow = document.getElementById("contact-sent-unit-row");
        const sourceValue = document.getElementById("contact-sent-source");
        const buildingValue = document.getElementById("contact-sent-building");
        const unitValue = document.getElementById("contact-sent-unit");
        if (sourceValue) sourceValue.textContent = cleanSource;
        if (buildingValue) buildingValue.textContent = building;
        if (unitValue) unitValue.textContent = unit;
        sourceRow?.classList.toggle("hidden", !cleanSource);
        buildingRow?.classList.toggle("hidden", !building);
        unitRow?.classList.toggle("hidden", !unit);
        details?.classList.toggle("hidden", !(cleanSource || building || unit));
      })();
    </script>

    <script define:vars={{ analyticsContext, sent, error }}>
      (() => {
        const dataLayer = (window.dataLayer = window.dataLayer || []);
        const pushEvent = (event) => dataLayer.push({ event, ...analyticsContext });
        pushEvent("atlas_contact_form_view");
        if (sent) pushEvent("atlas_contact_form_sent");
        if (error) pushEvent("atlas_contact_form_error");
      })();
    </script>

    <section id="contact-success" class="hidden space-y-2.5 rounded-xl border p-4" aria-live="polite">
      <h2 class="text-xl font-semibold">{t(lang, "Thanks!", "¡Gracias!")}</h2>
      <p class="text-sm opacity-80">{t(lang, "We'll contact you shortly.", "Te contactaremos en breve.")}</p>
      <div class="cta-cluster cta-inline flex flex-col gap-1.5 sm:flex-row">
        <a href={`/${lang}/units/`} class="ui-btn cta-secondary inline-flex items-center justify-center">
          {t(lang, "Back to Units", "Volver a Unidades")}
        </a>
        <a href={`/${lang}/downloads/`} class="ui-btn ui-btn--primary cta-primary inline-flex items-center justify-center">
          {t(lang, "Download brochure", "Descargar folleto")}
        </a>
      </div>
    </section>
  </section>
</BaseLayout>
