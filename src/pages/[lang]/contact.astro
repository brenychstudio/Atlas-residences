---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LANGS, type Lang, isLang, t } from "../../content/languages";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const lang = langParam as Lang;
---

<BaseLayout lang={lang} title={t(lang, "Contact | Atlas Residences", "Contacto | Atlas Residences") }>
  <section class="space-y-3">
    <h1 class="text-3xl tracking-tight">{t(lang, "Contact", "Contacto")}</h1>
    <p class="opacity-80">{t(lang, "Contact placeholder.", "Marcador de posición de contacto.")}</p>
  </section>
</BaseLayout>
