---
import BaseLayout from "../../core/layouts/BaseLayout.astro";
import AtmosphericBackdrop from "../ui/AtmosphericBackdrop.astro";
import DeveloperHeader from "../ui/DeveloperHeader.astro";
import AtlasFooter from "../ui/AtlasFooter.astro";
import AtlasRouteMotion from "../ui/AtlasRouteMotion.astro";
import StickyCTA from "../ui/StickyCTA.astro";

const props = Astro.props;
const pathname = Astro.url.pathname;
const lang = (props as { lang?: string }).lang;
---

<BaseLayout {...props}>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>
  <AtmosphericBackdrop />
  <DeveloperHeader slot="header" lang={lang} pathname={pathname} />
  <div data-dev-main class="awards-main-flow">
    <slot />
  </div>
  <AtlasFooter lang={lang} />
  <StickyCTA lang={lang} />
  <AtlasRouteMotion />
</BaseLayout>
