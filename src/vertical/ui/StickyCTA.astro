---
import { type Lang, isLang, t } from "../../content/languages";

const { lang } = Astro.props as { lang?: string };
const langParam = lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const L = langParam as Lang;
---

<div class="sticky-cta sticky-cta--mobile pointer-events-none fixed inset-x-0 bottom-0 z-40 px-4 pb-4 md:hidden" data-sticky-cta>
  <div class="sticky-cta__panel sticky-cta__panel--mobile pointer-events-auto mx-auto w-full max-w-[72rem]">
    <div class="grid grid-cols-1 gap-2">
      <a
        href={`/${L}/downloads/`}
        class="sticky-cta__primary inline-flex min-h-[44px] items-center justify-center rounded-xl px-4 text-sm font-medium"
      >
        {t(L, "Request price list", "Solicitar lista de precios")}
      </a>

      <div class="grid grid-cols-3 gap-2">
        <a
          href={`/${L}/contact/`}
          class="sticky-cta__secondary inline-flex min-h-[44px] items-center justify-center rounded-xl px-3 text-xs"
        >
          {t(L, "Book a viewing", "Reservar visita")}
        </a>

        <button
          type="button"
          class="sticky-cta__secondary inline-flex min-h-[44px] items-center justify-center rounded-xl px-3 text-xs"
        >
          WhatsApp
        </button>

        <button
          type="button"
          class="sticky-cta__secondary inline-flex min-h-[44px] items-center justify-center rounded-xl px-3 text-xs"
        >
          {t(L, "Call", "Llamar")}
        </button>
      </div>
    </div>
  </div>
</div>

<div class="sticky-cta sticky-cta--desktop hidden md:block" data-sticky-cta>
  <aside class="sticky-cta__shell mx-auto mt-8 w-full max-w-[72rem] px-6">
    <div class="sticky-cta__panel sticky-cta__panel--desktop">
      <div class="sticky-cta__content">
        <div class="sticky-cta__copy">
          <p class="sticky-cta__eyebrow">
            {t(L, "Sales access", "Acceso comercial")}
          </p>
          <p class="sticky-cta__note">
            {t(
              L,
              "Request documents, schedule a private viewing, or contact the sales team.",
              "Solicita documentos, agenda una visita privada o contacta con el equipo comercial.",
            )}
          </p>
        </div>

        <div class="sticky-cta__actions">
          <a
            href={`/${L}/downloads/`}
            class="sticky-cta__primary inline-flex min-h-[44px] items-center justify-center rounded-full px-5 text-sm"
          >
            {t(L, "Request price list", "Solicitar lista de precios")}
          </a>

          <a
            href={`/${L}/contact/`}
            class="sticky-cta__secondary inline-flex min-h-[44px] items-center justify-center rounded-full px-5 text-sm"
          >
            {t(L, "Book a viewing", "Reservar visita")}
          </a>

          <span class="sticky-cta__utility text-sm">
            WhatsApp / {t(L, "Call", "Llamar")} {t(L, "(placeholder)", "(placeholder)")}
          </span>
        </div>
      </div>
    </div>
  </aside>
</div>
