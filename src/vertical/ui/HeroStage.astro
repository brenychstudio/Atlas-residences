<div data-hero-stage data-hero-signature="hybrid" data-hero-debug="false" class="hero-stage relative">
  <div data-hero-stage-content>
    <slot />
  </div>
  <div data-hero-overlay="veil" aria-hidden="true" class="hero-stage__overlay hero-stage__overlay--veil hidden"></div>
  <div data-hero-overlay="glint" aria-hidden="true" class="hero-stage__overlay hero-stage__overlay--glint hidden"></div>
  <canvas
    data-webgl-hero
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 hidden h-full w-full"
  ></canvas>
</div>

<style>
  .hero-stage {
    position: relative;
    isolation: isolate;
  }

  .hero-stage [data-hero-stage-content] {
    position: relative;
    z-index: 12;
  }

  .hero-stage [data-webgl-hero],
  .hero-stage [data-hero-overlay] {
    pointer-events: none;
  }

  .hero-stage [data-webgl-hero] {
    z-index: 14;
    mix-blend-mode: screen;
    opacity: var(--hero-canvas-opacity, 0.9);
    filter: saturate(var(--hero-canvas-sat, 1.08)) contrast(1.02);
  }

  .hero-stage [data-hero-overlay] {
    position: absolute;
    inset: 0;
    z-index: 15;
    opacity: 0;
    will-change: transform, opacity;
    transition: opacity 380ms ease;
  }

  .hero-stage [data-hero-overlay="veil"] {
    z-index: 15;
    background:
      radial-gradient(
        140% 90% at calc(var(--hero-sun-x, 50) * 1%) calc(var(--hero-sun-y, 30) * 1%),
        color-mix(in oklab, var(--hero-veil-rgb, rgba(196, 220, 255, 0.2)), transparent 52%) 0%,
        transparent 66%
      ),
      linear-gradient(
        180deg,
        color-mix(in oklab, var(--hero-veil-rgb, rgba(180, 205, 245, 0.14)), transparent 40%) 0%,
        transparent 74%
      );
    mix-blend-mode: screen;
    opacity: var(--hero-veil-opacity, 0);
    transform: translate3d(var(--hero-veil-x, 0px), var(--hero-veil-y, 0px), 0) scale(1.03);
  }

  .hero-stage [data-hero-overlay="glint"] {
    z-index: 16;
    background:
      radial-gradient(
        44% 30% at calc(var(--hero-glint-x, 52) * 1%) calc(var(--hero-glint-y, 36) * 1%),
        color-mix(in oklab, var(--hero-glint-rgb, rgba(255, 236, 204, 0.34)), transparent 42%) 0%,
        transparent 78%
      ),
      linear-gradient(
        100deg,
        transparent 14%,
        color-mix(in oklab, var(--hero-glint-rgb, rgba(247, 229, 208, 0.22)), transparent 70%) 48%,
        transparent 85%
      );
    mix-blend-mode: soft-light;
    opacity: var(--hero-glint-opacity, 0);
    transform: translate3d(var(--hero-glint-parallax-x, 0px), var(--hero-glint-parallax-y, 0px), 0) scale(1.04);
    filter: blur(var(--hero-glint-blur, 1.3px));
  }
</style>

<script is:inline>
  (() => {
    const stage = document.currentScript?.previousElementSibling;
    if (!(stage instanceof HTMLElement) || !stage.matches("[data-hero-stage]")) return;

    const readDebugPreference = () => {
      const queryDebug = new URLSearchParams(window.location.search).get("heroDebug") === "1";
      let storageDebug = false;
      try {
        storageDebug = window.localStorage?.getItem("atlasHeroDebug") === "1";
      } catch {
        storageDebug = false;
      }
      return queryDebug || storageDebug;
    };

    const debugIntensity = readDebugPreference();
    stage.dataset.heroDebug = debugIntensity ? "true" : "false";

    const setDebugState = (active, mode) => {
      stage.dataset.webglActive = active ? "true" : "false";
      stage.dataset.webglMode = mode;
    };

    const updateOverlayState = (state) => {
      stage.style.setProperty("--hero-sun-x", `${(state.sunX * 100).toFixed(2)}`);
      stage.style.setProperty("--hero-sun-y", `${(state.sunY * 100).toFixed(2)}`);
      stage.style.setProperty("--hero-glint-x", `${(state.glintX * 100).toFixed(2)}`);
      stage.style.setProperty("--hero-glint-y", `${(state.glintY * 100).toFixed(2)}`);
      stage.style.setProperty("--hero-veil-opacity", state.veilOpacity.toFixed(3));
      stage.style.setProperty("--hero-glint-opacity", state.glintOpacity.toFixed(3));
      stage.style.setProperty("--hero-canvas-opacity", state.canvasOpacity.toFixed(3));
      stage.style.setProperty("--hero-canvas-sat", state.canvasSaturation.toFixed(3));
      stage.style.setProperty("--hero-veil-x", `${state.veilX.toFixed(2)}px`);
      stage.style.setProperty("--hero-veil-y", `${state.veilY.toFixed(2)}px`);
      stage.style.setProperty("--hero-glint-parallax-x", `${state.glintParallaxX.toFixed(2)}px`);
      stage.style.setProperty("--hero-glint-parallax-y", `${state.glintParallaxY.toFixed(2)}px`);
      stage.style.setProperty("--hero-glint-blur", `${state.glintBlur.toFixed(2)}px`);
      stage.style.setProperty("--hero-veil-rgb", state.veilColor);
      stage.style.setProperty("--hero-glint-rgb", state.glintColor);
    };

    setDebugState(false, "fallback");

    const canvas = stage.querySelector("[data-webgl-hero]");
    const veilLayer = stage.querySelector('[data-hero-overlay="veil"]');
    const glintLayer = stage.querySelector('[data-hero-overlay="glint"]');
    if (!(canvas instanceof HTMLCanvasElement) || !(veilLayer instanceof HTMLElement) || !(glintLayer instanceof HTMLElement)) {
      return;
    }

    const reduceMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;
    const isDesktop = window.innerWidth >= 1024;
    const memOk = typeof navigator.deviceMemory !== "number" || navigator.deviceMemory >= 4;
    const cpuOk = typeof navigator.hardwareConcurrency !== "number" || navigator.hardwareConcurrency >= 4;

    if (!isDesktop || reduceMotion || !memOk || !cpuOk) return;

    const gl =
      canvas.getContext("webgl", { antialias: true, alpha: true, powerPreference: "low-power" }) ||
      canvas.getContext("experimental-webgl", { antialias: true, alpha: true, powerPreference: "low-power" });

    if (!gl) return;

    const vertexSrc = `
      attribute vec2 a_pos;
      varying vec2 v_uv;
      void main() {
        v_uv = 0.5 * (a_pos + 1.0);
        gl_Position = vec4(a_pos, 0.0, 1.0);
      }
    `;

    const fragmentSrc = `
      precision mediump float;
      varying vec2 v_uv;
      uniform vec2 u_resolution;
      uniform float u_time;
      uniform vec2 u_pointer;
      uniform vec2 u_pointer_soft;
      uniform vec2 u_pointer_deep;
      uniform vec2 u_sun;
      uniform float u_scroll;
      uniform float u_sun_mix;
      uniform float u_bluehour;
      uniform float u_sunset;
      uniform float u_debug;

      void main() {
        vec2 uv = v_uv;
        float ratio = u_resolution.x / max(u_resolution.y, 1.0);

        vec2 p = uv - vec2(0.5, 0.52);
        p.x *= ratio;

        vec2 sun = u_sun;
        sun.x *= ratio;
        vec2 pointerFront = (u_pointer - 0.5) * vec2(0.048, 0.03);
        vec2 pointerMid = (u_pointer_soft - 0.5) * vec2(0.03, 0.022);
        vec2 pointerBack = (u_pointer_deep - 0.5) * vec2(0.015, 0.011);

        vec2 glowPos = vec2(sun.x, u_sun.y) + pointerMid;
        vec2 hazePos = vec2(sun.x * 0.82, u_sun.y * 0.98 + 0.04) + pointerFront;
        vec2 skyPos = vec2(sun.x * 0.62, u_sun.y * 1.08 + 0.06) + pointerBack;

        float dayBlend = clamp(1.0 - u_sun_mix, 0.0, 1.0);
        float blue = clamp(u_bluehour, 0.0, 1.0);
        float sunset = clamp(u_sunset, 0.0, 1.0);

        float glow = exp(-(8.2 - sunset * 1.3 + blue * 0.45) * distance(p, glowPos));
        float bloom = exp(-(3.4 - sunset * 1.15 + blue * 0.34) * distance(p, glowPos));
        float hazeLayer = exp(-(2.45 - sunset * 0.58 + blue * 0.43) * distance(p, hazePos));
        float skyLayer = exp(-(1.48 - blue * 0.25 + sunset * 0.19) * distance(p, skyPos));

        float horizon = smoothstep(0.14, 0.88, uv.y);
        float haze = (1.0 - horizon) * (0.14 + blue * 0.1 + sunset * 0.16 - dayBlend * 0.014);

        float edge = smoothstep(0.76, 0.26, length(p));
        float vignette = (1.0 - edge) * 0.08;

        float drift = sin(u_time * 0.22 + uv.x * 4.2) * 0.009;
        float scrollTint = clamp(u_scroll, 0.0, 1.0) * (0.065 + blue * 0.044 + sunset * 0.061);
        float sunMix = clamp(u_sun_mix, 0.0, 1.0);
        float debugBoost = 1.0 + u_debug * 0.16;

        vec3 coolDay = vec3(0.78, 0.9, 1.0);
        vec3 blueHour = vec3(0.5, 0.62, 0.88);
        vec3 warmSunset = vec3(1.0, 0.78, 0.56);

        vec3 ambient = mix(coolDay, blueHour, blue * 0.95 + sunMix * 0.04);
        ambient = mix(ambient, warmSunset, sunset * 0.92);

        float glowIntensity = (0.175 + dayBlend * 0.05 + sunset * 0.19 + sunMix * 0.055 + blue * 0.03) * debugBoost;
        float bloomIntensity = (0.09 + sunset * 0.11 + blue * 0.055) * debugBoost;
        float hazeIntensity = (0.07 + blue * 0.04 + sunset * 0.056) * debugBoost;
        float skyIntensity = (0.055 + dayBlend * 0.025 + blue * 0.048) * debugBoost;
        float ambientIntensity = (0.09 + dayBlend * 0.03 + blue * 0.05 + sunset * 0.07) * debugBoost;

        vec3 skyColor = mix(coolDay, blueHour, blue * 0.92 + sunMix * 0.08);
        skyColor = mix(skyColor, warmSunset, sunset * 0.72);

        vec3 color = ambient * (haze + drift + scrollTint)
          + warmSunset * glow * glowIntensity
          + ambient * bloom * bloomIntensity
          + ambient * hazeLayer * hazeIntensity
          + skyColor * skyLayer * skyIntensity;

        float alpha = clamp(
          glow * (0.15 + sunset * 0.125 + sunMix * 0.038)
          + bloom * (0.082 + sunset * 0.064 + blue * 0.03)
          + hazeLayer * (0.05 + sunset * 0.045 + blue * 0.018)
          + skyLayer * (0.03 + blue * 0.03)
          + (haze + vignette) * ambientIntensity,
          0.0,
          0.38
        );
        gl_FragColor = vec4(color, alpha);
      }
    `;

    const compileShader = (type, source) => {
      const shader = gl.createShader(type);
      if (!shader) return null;
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
        gl.deleteShader(shader);
        return null;
      }
      return shader;
    };

    const vertex = compileShader(gl.VERTEX_SHADER, vertexSrc);
    const fragment = compileShader(gl.FRAGMENT_SHADER, fragmentSrc);
    if (!vertex || !fragment) return;

    const program = gl.createProgram();
    if (!program) return;
    gl.attachShader(program, vertex);
    gl.attachShader(program, fragment);
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;

    setDebugState(true, "morning");

    gl.useProgram(program);

    const buffer = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);

    const posLoc = gl.getAttribLocation(program, "a_pos");
    gl.enableVertexAttribArray(posLoc);
    gl.vertexAttribPointer(posLoc, 2, gl.FLOAT, false, 0, 0);

    const uResolution = gl.getUniformLocation(program, "u_resolution");
    const uTime = gl.getUniformLocation(program, "u_time");
    const uPointer = gl.getUniformLocation(program, "u_pointer");
    const uPointerSoft = gl.getUniformLocation(program, "u_pointer_soft");
    const uPointerDeep = gl.getUniformLocation(program, "u_pointer_deep");
    const uSun = gl.getUniformLocation(program, "u_sun");
    const uScroll = gl.getUniformLocation(program, "u_scroll");
    const uSunMix = gl.getUniformLocation(program, "u_sun_mix");
    const uBlueHour = gl.getUniformLocation(program, "u_bluehour");
    const uSunset = gl.getUniformLocation(program, "u_sunset");
    const uDebug = gl.getUniformLocation(program, "u_debug");

    const frame = stage.querySelector("[data-sun-hero-frame]");
    const sunRoot = stage.querySelector("[data-sun-hero]");

    let pointerX = 0.5;
    let pointerY = 0.4;
    let pointerSoftX = 0.5;
    let pointerSoftY = 0.4;
    let pointerDeepX = 0.5;
    let pointerDeepY = 0.4;
    let pointerTargetX = 0.5;
    let pointerTargetY = 0.4;
    let inView = false;
    let isVisible = document.visibilityState !== "hidden";
    let raf = 0;

    const state = {
      sunX: 0.5,
      sunY: 0.7,
      sunMix: 0,
      scroll: 0,
      blueHour: 0,
      sunset: 0,
      veilOpacity: 0,
      glintOpacity: 0,
      canvasOpacity: 0.92,
      canvasSaturation: 1.08,
      veilX: 0,
      veilY: 0,
      glintParallaxX: 0,
      glintParallaxY: 0,
      glintBlur: 1.35,
      veilColor: "rgba(198, 220, 255, 0.22)",
      glintColor: "rgba(248, 233, 210, 0.3)",
      glintX: 0.52,
      glintY: 0.36,
    };

    const lerp = (from, to, t) => from + (to - from) * t;

    const resolveMode = (blueHour, sunset) => {
      if (sunset >= 0.16) return "sunset";
      if (blueHour >= 0.14) return "bluehour";
      return "morning";
    };

    const readVarNumber = (name, fallback) => {
      if (!(sunRoot instanceof HTMLElement)) return fallback;
      const value = getComputedStyle(sunRoot).getPropertyValue(name).trim();
      if (!value) return fallback;
      const n = parseFloat(value);
      if (!Number.isFinite(n)) return fallback;
      return n;
    };

    const updateCanvasBounds = () => {
      if (!(frame instanceof HTMLElement)) return;
      const stageRect = stage.getBoundingClientRect();
      const frameRect = frame.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas.style.left = `${frameRect.left - stageRect.left}px`;
      canvas.style.top = `${frameRect.top - stageRect.top}px`;
      canvas.style.width = `${frameRect.width}px`;
      canvas.style.height = `${frameRect.height}px`;

      const width = Math.max(1, Math.floor(frameRect.width * dpr));
      const height = Math.max(1, Math.floor(frameRect.height * dpr));
      if (canvas.width !== width || canvas.height !== height) {
        canvas.width = width;
        canvas.height = height;
        gl.viewport(0, 0, width, height);
      }
    };

    const draw = (time) => {
      if (!inView || !isVisible) return;

      updateCanvasBounds();
      const targetSunX = readVarNumber("--sun-x", 50) / 100;
      const targetSunY = readVarNumber("--sun-y", 30) / 100;
      const targetSunMix = readVarNumber("--sun", 0);
      const targetScroll = readVarNumber("--scroll", 0);
      const targetBlueHour = readVarNumber("--bluehour-opacity", 0);
      const targetSunset = readVarNumber("--sunset-opacity", 0);

      const modeBlend = Math.max(targetBlueHour, targetSunset);
      const debugBoost = debugIntensity ? 1.16 : 1;

      pointerX = lerp(pointerX, pointerTargetX, 0.11);
      pointerY = lerp(pointerY, pointerTargetY, 0.11);
      pointerSoftX = lerp(pointerSoftX, pointerTargetX, 0.082);
      pointerSoftY = lerp(pointerSoftY, pointerTargetY, 0.082);
      pointerDeepX = lerp(pointerDeepX, pointerTargetX, 0.054);
      pointerDeepY = lerp(pointerDeepY, pointerTargetY, 0.054);

      state.sunX = lerp(state.sunX, targetSunX, 0.09);
      state.sunY = lerp(state.sunY, targetSunY, 0.09);
      state.sunMix = lerp(state.sunMix, targetSunMix, 0.07);
      state.scroll = lerp(state.scroll, targetScroll, 0.07);
      state.blueHour = lerp(state.blueHour, targetBlueHour, 0.09);
      state.sunset = lerp(state.sunset, targetSunset, 0.09);

      const pointerCenterX = pointerX - 0.5;
      const pointerCenterY = pointerY - 0.5;
      const pointerSoftCenterX = pointerSoftX - 0.5;
      const pointerSoftCenterY = pointerSoftY - 0.5;
      const pointerDeepCenterX = pointerDeepX - 0.5;
      const pointerDeepCenterY = pointerDeepY - 0.5;

      const veilTarget = (0.15 + state.sunset * 0.1 + state.blueHour * 0.08 + state.sunMix * 0.06) * debugBoost;
      const glintTarget = (0.11 + state.sunset * 0.13 + state.blueHour * 0.09 + state.sunMix * 0.045) * debugBoost;
      const canvasTarget = (0.92 + modeBlend * 0.07 + state.sunset * 0.03) * (debugIntensity ? 1.04 : 1);
      const satTarget = 1.06 + state.sunset * 0.1 + state.blueHour * 0.06;

      state.veilOpacity = lerp(state.veilOpacity, veilTarget, 0.08);
      state.glintOpacity = lerp(state.glintOpacity, glintTarget, 0.08);
      state.canvasOpacity = lerp(state.canvasOpacity, canvasTarget, 0.08);
      state.canvasSaturation = lerp(state.canvasSaturation, satTarget, 0.08);
      state.veilX = lerp(state.veilX, pointerDeepCenterX * 16 + state.scroll * 4, 0.08);
      state.veilY = lerp(state.veilY, pointerDeepCenterY * 10 - state.scroll * 3, 0.08);
      state.glintParallaxX = lerp(state.glintParallaxX, pointerSoftCenterX * 24 + state.sunset * 5 - state.blueHour * 4, 0.1);
      state.glintParallaxY = lerp(state.glintParallaxY, pointerSoftCenterY * 16 + state.sunset * 2, 0.1);
      state.glintBlur = lerp(state.glintBlur, 1.2 + state.blueHour * 0.7 + state.sunset * 0.4, 0.08);
      state.glintX = lerp(state.glintX, state.sunX * 0.78 + 0.18 + pointerSoftCenterX * 0.08, 0.09);
      state.glintY = lerp(state.glintY, state.sunY * 0.72 + 0.14 + pointerSoftCenterY * 0.06, 0.09);

      if (state.sunset >= 0.16) {
        state.veilColor = "rgba(245, 192, 142, 0.3)";
        state.glintColor = "rgba(255, 216, 162, 0.38)";
      } else if (state.blueHour >= 0.14) {
        state.veilColor = "rgba(136, 164, 222, 0.28)";
        state.glintColor = "rgba(172, 196, 245, 0.32)";
      } else {
        state.veilColor = "rgba(198, 221, 255, 0.22)";
        state.glintColor = "rgba(241, 236, 224, 0.27)";
      }

      stage.dataset.webglMode = resolveMode(targetBlueHour, targetSunset);
      updateOverlayState(state);

      gl.uniform2f(uResolution, canvas.width, canvas.height);
      gl.uniform1f(uTime, time * 0.001);
      gl.uniform2f(uPointer, pointerX, pointerY);
      gl.uniform2f(uPointerSoft, pointerSoftX, pointerSoftY);
      gl.uniform2f(uPointerDeep, pointerDeepX, pointerDeepY);
      gl.uniform2f(uSun, state.sunX - 0.5, 1.0 - state.sunY);
      gl.uniform1f(uScroll, state.scroll);
      gl.uniform1f(uSunMix, state.sunMix);
      gl.uniform1f(uBlueHour, state.blueHour);
      gl.uniform1f(uSunset, state.sunset);
      gl.uniform1f(uDebug, debugIntensity ? 1 : 0);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

      raf = window.requestAnimationFrame(draw);
    };

    const start = () => {
      if (raf || !inView || !isVisible) return;
      canvas.classList.remove("hidden");
      veilLayer.classList.remove("hidden");
      glintLayer.classList.remove("hidden");
      raf = window.requestAnimationFrame(draw);
    };

    const stop = () => {
      if (raf) {
        window.cancelAnimationFrame(raf);
        raf = 0;
      }
    };

    stage.addEventListener("pointermove", (event) => {
      if (!(frame instanceof HTMLElement)) return;
      const rect = frame.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      pointerTargetX = Math.min(1, Math.max(0, (event.clientX - rect.left) / rect.width));
      pointerTargetY = Math.min(1, Math.max(0, (event.clientY - rect.top) / rect.height));
    });

    stage.addEventListener("pointerleave", () => {
      pointerTargetX = 0.5;
      pointerTargetY = 0.4;
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        inView = Boolean(entry?.isIntersecting);
        if (inView) start();
        else stop();
      },
      { threshold: 0.05 },
    );

    observer.observe(stage);
    updateCanvasBounds();

    document.addEventListener("visibilitychange", () => {
      isVisible = document.visibilityState !== "hidden";
      if (isVisible) start();
      else stop();
    });

    window.addEventListener("resize", updateCanvasBounds, { passive: true });
    window.addEventListener("scroll", updateCanvasBounds, { passive: true });
  })();
</script>
