<div data-hero-stage class="hero-stage relative">
  <div data-hero-stage-content>
    <slot />
  </div>
  <canvas
    data-webgl-hero
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 hidden h-full w-full"
  ></canvas>
</div>

<style>
  .hero-stage {
    position: relative;
  }

  .hero-stage [data-webgl-hero] {
    z-index: 14;
  }
</style>

<script is:inline>
  (() => {
    const stage = document.currentScript?.previousElementSibling;
    if (!(stage instanceof HTMLElement) || !stage.matches("[data-hero-stage]")) return;

    const canvas = stage.querySelector("[data-webgl-hero]");
    if (!(canvas instanceof HTMLCanvasElement)) return;

    const reduceMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;
    const isDesktop = window.innerWidth >= 1024;
    const memOk = typeof navigator.deviceMemory !== "number" || navigator.deviceMemory >= 4;
    const cpuOk = typeof navigator.hardwareConcurrency !== "number" || navigator.hardwareConcurrency >= 4;

    if (!isDesktop || reduceMotion || !memOk || !cpuOk) return;

    const gl =
      canvas.getContext("webgl", { antialias: true, alpha: true, powerPreference: "low-power" }) ||
      canvas.getContext("experimental-webgl", { antialias: true, alpha: true, powerPreference: "low-power" });

    if (!gl) return;

    const vertexSrc = `
      attribute vec2 a_pos;
      varying vec2 v_uv;
      void main() {
        v_uv = 0.5 * (a_pos + 1.0);
        gl_Position = vec4(a_pos, 0.0, 1.0);
      }
    `;

    const fragmentSrc = `
      precision mediump float;
      varying vec2 v_uv;
      uniform vec2 u_resolution;
      uniform float u_time;
      uniform vec2 u_pointer;
      uniform vec2 u_sun;
      uniform float u_scroll;
      uniform float u_sun_mix;

      void main() {
        vec2 uv = v_uv;
        float ratio = u_resolution.x / max(u_resolution.y, 1.0);

        vec2 p = uv - vec2(0.5, 0.52);
        p.x *= ratio;

        vec2 sun = u_sun;
        sun.x *= ratio;
        vec2 glowPos = vec2(sun.x, u_sun.y) + (u_pointer - 0.5) * vec2(0.018, 0.012);

        float glow = exp(-12.0 * distance(p, glowPos));
        float bloom = exp(-5.0 * distance(p, glowPos));

        float horizon = smoothstep(0.12, 0.86, uv.y);
        float haze = (1.0 - horizon) * 0.11;

        float edge = smoothstep(0.75, 0.28, length(p));
        float vignette = (1.0 - edge) * 0.11;

        float drift = sin(u_time * 0.2 + uv.x * 4.0) * 0.01;
        float scrollTint = clamp(u_scroll, 0.0, 1.0) * 0.06;
        float sunMix = clamp(u_sun_mix, 0.0, 1.0);

        vec3 warm = vec3(1.0, 0.90, 0.72);
        vec3 hazeCol = vec3(0.82, 0.88, 0.94);
        vec3 color = warm * glow * (0.16 + sunMix * 0.07) + warm * bloom * 0.08 + hazeCol * (haze + drift + scrollTint);

        float alpha = clamp(glow * (0.14 + sunMix * 0.08) + bloom * 0.08 + haze + vignette, 0.0, 0.22);
        gl_FragColor = vec4(color, alpha);
      }
    `;

    const compileShader = (type, source) => {
      const shader = gl.createShader(type);
      if (!shader) return null;
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
        gl.deleteShader(shader);
        return null;
      }
      return shader;
    };

    const vertex = compileShader(gl.VERTEX_SHADER, vertexSrc);
    const fragment = compileShader(gl.FRAGMENT_SHADER, fragmentSrc);
    if (!vertex || !fragment) return;

    const program = gl.createProgram();
    if (!program) return;
    gl.attachShader(program, vertex);
    gl.attachShader(program, fragment);
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;

    gl.useProgram(program);

    const buffer = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);

    const posLoc = gl.getAttribLocation(program, "a_pos");
    gl.enableVertexAttribArray(posLoc);
    gl.vertexAttribPointer(posLoc, 2, gl.FLOAT, false, 0, 0);

    const uResolution = gl.getUniformLocation(program, "u_resolution");
    const uTime = gl.getUniformLocation(program, "u_time");
    const uPointer = gl.getUniformLocation(program, "u_pointer");
    const uSun = gl.getUniformLocation(program, "u_sun");
    const uScroll = gl.getUniformLocation(program, "u_scroll");
    const uSunMix = gl.getUniformLocation(program, "u_sun_mix");

    const frame = stage.querySelector("[data-sun-hero-frame]");
    const sunRoot = stage.querySelector("[data-sun-hero]");

    let pointerX = 0.5;
    let pointerY = 0.4;
    let inView = false;
    let raf = 0;

    const readVarNumber = (name, fallback) => {
      if (!(sunRoot instanceof HTMLElement)) return fallback;
      const value = getComputedStyle(sunRoot).getPropertyValue(name).trim();
      if (!value) return fallback;
      const n = parseFloat(value);
      if (!Number.isFinite(n)) return fallback;
      return n;
    };

    const updateCanvasBounds = () => {
      if (!(frame instanceof HTMLElement)) return;
      const stageRect = stage.getBoundingClientRect();
      const frameRect = frame.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas.style.left = `${frameRect.left - stageRect.left}px`;
      canvas.style.top = `${frameRect.top - stageRect.top}px`;
      canvas.style.width = `${frameRect.width}px`;
      canvas.style.height = `${frameRect.height}px`;

      const width = Math.max(1, Math.floor(frameRect.width * dpr));
      const height = Math.max(1, Math.floor(frameRect.height * dpr));
      if (canvas.width !== width || canvas.height !== height) {
        canvas.width = width;
        canvas.height = height;
        gl.viewport(0, 0, width, height);
      }
    };

    const draw = (time) => {
      if (!inView) return;

      updateCanvasBounds();
      const sunX = readVarNumber("--sun-x", 50) / 100;
      const sunY = readVarNumber("--sun-y", 30) / 100;
      const sunMix = readVarNumber("--sun", 0);
      const scroll = readVarNumber("--scroll", 0);

      gl.uniform2f(uResolution, canvas.width, canvas.height);
      gl.uniform1f(uTime, time * 0.001);
      gl.uniform2f(uPointer, pointerX, pointerY);
      gl.uniform2f(uSun, sunX - 0.5, 1.0 - sunY);
      gl.uniform1f(uScroll, scroll);
      gl.uniform1f(uSunMix, sunMix);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

      raf = window.requestAnimationFrame(draw);
    };

    const start = () => {
      if (raf) return;
      canvas.classList.remove("hidden");
      raf = window.requestAnimationFrame(draw);
    };

    const stop = () => {
      if (raf) {
        window.cancelAnimationFrame(raf);
        raf = 0;
      }
    };

    stage.addEventListener("pointermove", (event) => {
      if (!(frame instanceof HTMLElement)) return;
      const rect = frame.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      pointerX = Math.min(1, Math.max(0, (event.clientX - rect.left) / rect.width));
      pointerY = Math.min(1, Math.max(0, (event.clientY - rect.top) / rect.height));
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        inView = Boolean(entry?.isIntersecting);
        if (inView) start();
        else stop();
      },
      { threshold: 0.05 },
    );

    observer.observe(stage);
    updateCanvasBounds();
    window.addEventListener("resize", updateCanvasBounds, { passive: true });
    window.addEventListener("scroll", updateCanvasBounds, { passive: true });
  })();
</script>
