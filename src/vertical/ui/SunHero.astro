---
type Props = {
  morningImage?: string;
  sunsetImage?: string;
  mobileImage?: string;
  alt: string;
  sliderLabel: string;
  morningLabel: string;
  sunsetLabel: string;
};

const {
  morningImage = "",
  sunsetImage = "",
  mobileImage = "",
  alt,
  sliderLabel,
  morningLabel,
  sunsetLabel,
} = Astro.props as Props;

const fallbackPoster = morningImage.trim() || sunsetImage.trim();
const hasPoster = Boolean(fallbackPoster);
const hasSunset = Boolean(sunsetImage.trim() && sunsetImage.trim() !== fallbackPoster);
---

{hasPoster && (
  <div class="space-y-3" data-sun-hero style="--sun:0;">
    <div class="relative overflow-hidden rounded-2xl border bg-slate-100">
      <picture>
        {mobileImage && <source media="(max-width: 640px)" srcset={mobileImage} />}
        <img
          src={fallbackPoster}
          alt={alt}
          class="h-full w-full object-cover"
          loading="eager"
          decoding="async"
          width="1600"
          height="900"
        />
      </picture>

      {hasSunset && (
        <img
          src={sunsetImage}
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 h-full w-full object-cover transition-opacity duration-500"
          style="opacity: var(--sun);"
          loading="lazy"
          decoding="async"
          width="1600"
          height="900"
        />
      )}
    </div>

    {hasSunset && (
      <div class="hidden items-center gap-3 rounded-xl border bg-white/90 px-3 py-2 text-xs sm:text-sm" data-sun-slider-wrap>
        <span class="shrink-0 opacity-70">{morningLabel}</span>
        <input
          type="range"
          min="0"
          max="1"
          step="0.01"
          value="0"
          class="h-2 w-full accent-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black focus-visible:ring-offset-2"
          aria-label={sliderLabel}
          data-sun-slider
        />
        <span class="shrink-0 opacity-70">{sunsetLabel}</span>
      </div>
    )}
  </div>
)}

<script is:inline>
  (() => {
    document.querySelectorAll('[data-sun-hero]').forEach((root) => {
      const sliderWrap = root.querySelector('[data-sun-slider-wrap]');
      const slider = root.querySelector('[data-sun-slider]');
      if (!sliderWrap || !slider) return;
      sliderWrap.classList.remove('hidden');
      sliderWrap.classList.add('flex');
      const update = () => {
        const value = Math.max(0, Math.min(1, Number(slider.value) || 0));
        root.style.setProperty('--sun', String(value));
      };
      slider.addEventListener('input', update);
      update();
    });
  })();
</script>
