---
// STABILITY LOCK (canonical implementation):
// - This file is canonical for Home hero behavior.
// - Do NOT change data attributes, CSS custom properties, or inline script flow without intentional redesign.
// - Do NOT remove poster-first fallback behavior.

type Props = {
  morningImage?: string;
  bluehourImage?: string;
  sunsetImage?: string;
  mobileImage?: string;

  alt?: string;
  sliderLabel?: string;
  morningLabel?: string;
  bluehourLabel?: string;
  sunsetLabel?: string;
};

const trim = (x: unknown) => String(x ?? "").trim();

const {
  morningImage = "",
  bluehourImage = "",
  sunsetImage = "",
  mobileImage = "",

  alt = "",

  sliderLabel = "Sun position",
  morningLabel = "Morning",
  bluehourLabel = "Blue hour",
  sunsetLabel = "Sunset",
} = Astro.props as Props;

const morningSrc = trim(morningImage);
const bluehourSrc = trim(bluehourImage);
const sunsetSrc = trim(sunsetImage);
const mobileSrc = trim(mobileImage);

const poster = morningSrc || bluehourSrc || sunsetSrc;
const hasPoster = Boolean(poster);

const hasSunset = Boolean(sunsetSrc) && sunsetSrc !== poster;
const hasBluehour = Boolean(bluehourSrc) && bluehourSrc !== poster && bluehourSrc !== sunsetSrc;

// show slider only when there is something to blend
const hasBlend = hasSunset || hasBluehour;
---

{hasPoster && (
  <div
    class="space-y-3"
    data-sun-hero
    data-has-bluehour={hasBluehour ? "true" : "false"}
    data-has-blend={hasBlend ? "true" : "false"}
    style="--sun:0; --bluehour-opacity:0; --sunset-opacity:0; --px:0px; --py:0px; --fog-shift:0; --sun-x:50%; --sun-y:34%; --glint-offset:0%; --scroll:0; --scroll-y:0px;"
  >
    <div class="sun-hero-frame relative overflow-hidden rounded-2xl border bg-slate-100" data-sun-hero-frame>
      <picture>
        {mobileSrc ? <source media="(max-width: 640px)" srcset={mobileSrc} /> : null}
        <img
          src={poster}
          alt={alt}
          class="sun-hero-layer h-full w-full object-cover"
          loading="eager"
          decoding="async"
          width="1600"
          height="900"
          style="transform: translate3d(var(--px), var(--py), 0);"
        />
      </picture>

      {hasBluehour && (
        <img
          src={bluehourSrc}
          alt=""
          aria-hidden="true"
          class="sun-hero-layer pointer-events-none absolute inset-0 h-full w-full object-cover"
          loading="lazy"
          decoding="async"
          width="1600"
          height="900"
          style="opacity: var(--bluehour-opacity); transform: translate3d(var(--px), var(--py), 0);"
        />
      )}

      {hasSunset && (
        <img
          src={sunsetSrc}
          alt=""
          aria-hidden="true"
          class="sun-hero-layer pointer-events-none absolute inset-0 h-full w-full object-cover"
          loading="lazy"
          decoding="async"
          width="1600"
          height="900"
          style="opacity: var(--sunset-opacity); transform: translate3d(var(--px), var(--py), 0);"
        />
      )}

      <div class="sun-disc" aria-hidden="true"></div>
      <div class="sun-glint" aria-hidden="true"></div>
    </div>

    {hasBlend ? (
      <div
        class="hidden items-center gap-2 rounded-xl border bg-white/90 px-3 py-2 text-xs sm:gap-3 sm:px-4 sm:text-sm"
        data-sun-slider-wrap
      >
        <span class="shrink-0 opacity-70" data-morning-label>{morningLabel}</span>

        <input
          type="range"
          min="0"
          max="1"
          step="0.01"
          value="0"
          aria-label={sliderLabel}
          class="h-2 w-full cursor-pointer accent-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black/60"
          data-sun-slider
        />

        <span class="shrink-0 opacity-70" data-sunset-label>{sunsetLabel}</span>

        {hasBluehour && <span class="sr-only" data-bluehour-label>{bluehourLabel}</span>}
      </div>
    ) : null}
  </div>
)}

<style>
  .sun-hero-frame {
    aspect-ratio: 16 / 9;
  }

  .sun-hero-layer {
    will-change: transform, opacity;
    transition: transform 180ms ease-out;
  }

  .sun-hero-frame::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse at center,
      transparent 52%,
      rgba(15, 23, 42, calc(0.14 + var(--fog-shift) * 0.10 + var(--scroll) * 0.06)) 100%
    );
    z-index: 10;
    transform: translate3d(0, var(--scroll-y), 0);
  }

  .sun-hero-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.05;
    background-image: radial-gradient(rgba(255, 255, 255, 0.45) 0.45px, transparent 0.55px);
    background-size: 2.5px 2.5px;
    z-index: 11;
  }

  .sun-disc {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.22;
    z-index: 12;
    background: radial-gradient(
      circle at var(--sun-x) var(--sun-y),
      rgba(255, 244, 214, 0.45) 0%,
      rgba(255, 244, 214, 0.18) 10%,
      rgba(255, 244, 214, 0.08) 22%,
      transparent 40%
    );
    mix-blend-mode: screen;
    transform: translate3d(0, var(--scroll-y), 0);
  }

  .sun-glint {
    position: absolute;
    inset: -20%;
    pointer-events: none;
    z-index: 13;
    opacity: calc(0.10 + var(--scroll) * 0.05);
    transform: translateX(var(--glint-offset)) translateY(calc(var(--scroll-y) * 0.5)) rotate(-10deg);
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.10) 45%,
      rgba(255, 255, 255, 0.22) 50%,
      rgba(255, 255, 255, 0.10) 55%,
      transparent 100%
    );
    mix-blend-mode: overlay;
  }

  @media (prefers-reduced-motion: reduce) {
    .sun-hero-layer {
      transition: none;
    }

    .sun-disc,
    .sun-glint {
      display: none;
    }
  }
</style>

<!-- STABILITY LOCK (canonical): Do NOT change script flow, data attributes, or CSS variable contract without intentional redesign. -->
<script is:inline>
  (() => {
    const reduceMotion =
      window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const clamp01 = (v) => Math.max(0, Math.min(1, v));
    const lerp = (a, b, t) => a + (b - a) * t;

    document.querySelectorAll("[data-sun-hero]").forEach((root) => {
      const frame = root.querySelector("[data-sun-hero-frame]");
      const wrap = root.querySelector("[data-sun-slider-wrap]");
      const slider = root.querySelector("[data-sun-slider]");
      if (!frame || !wrap || !slider) return;

      // show slider only when JS runs
      wrap.classList.remove("hidden");
      wrap.classList.add("flex");

      const hasBluehour = root.getAttribute("data-has-bluehour") === "true";
      const morningText = (root.querySelector("[data-morning-label]")?.textContent || "Morning").trim();
      const sunsetText = (root.querySelector("[data-sunset-label]")?.textContent || "Sunset").trim();
      const bluehourText = (root.querySelector("[data-bluehour-label]")?.textContent || "Blue hour").trim();
      const ariaBase = slider.getAttribute("aria-label") || "Sun position";

      let target = clamp01(Number(slider.value || 0));
      let current = target;
      let raf = 0;

      const setOpacities = (x) => {
        const v = clamp01(x);

        root.style.setProperty("--sun", String(v));
        root.style.setProperty("--fog-shift", String(v));

        const sunX = 32 + v * 42;
        const sunY = 34 - v * 8;
        root.style.setProperty("--sun-x", `${sunX.toFixed(2)}%`);
        root.style.setProperty("--sun-y", `${sunY.toFixed(2)}%`);
        root.style.setProperty("--glint-offset", `${((v - 0.5) * 18).toFixed(2)}%`);

        if (hasBluehour) {
          let b = 0;
          let s = 0;

          if (v <= 0.5) {
            b = v / 0.5;
            s = 0;
          } else {
            b = 1 - (v - 0.5) / 0.5;
            s = (v - 0.5) / 0.5;
          }

          root.style.setProperty("--bluehour-opacity", String(b));
          root.style.setProperty("--sunset-opacity", String(s));
        } else {
          root.style.setProperty("--bluehour-opacity", "0");
          root.style.setProperty("--sunset-opacity", String(v));
        }
      };

      const setValueText = (v) => {
        const x = clamp01(v);

        if (!hasBluehour) {
          slider.setAttribute(
            "aria-valuetext",
            `${ariaBase}: ${x < 0.5 ? morningText : sunsetText}`
          );
          return;
        }

        const label = x < 0.33 ? morningText : x < 0.66 ? bluehourText : sunsetText;
        slider.setAttribute("aria-valuetext", `${ariaBase}: ${label}`);
      };

      const tick = () => {
        current = lerp(current, target, 0.12);

        if (Math.abs(current - target) < 0.001) {
          current = target;
          setOpacities(current);
          setValueText(current);
          raf = 0;
          return;
        }

        setOpacities(current);
        setValueText(current);
        raf = requestAnimationFrame(tick);
      };

      slider.addEventListener("input", () => {
        target = clamp01(Number(slider.value));
        if (!raf) raf = requestAnimationFrame(tick);
      });

      let active = true;
      let scrollRaf = 0;

      const resetParallax = () => {
        root.style.setProperty("--px", "0px");
        root.style.setProperty("--py", "0px");
      };

      const resetScroll = () => {
        root.style.setProperty("--scroll", "0");
        root.style.setProperty("--scroll-y", "0px");
      };

      const applyParallax = (clientX, clientY) => {
        const rect = frame.getBoundingClientRect();
        const x = (clientX - rect.left) / rect.width - 0.5;
        const y = (clientY - rect.top) / rect.height - 0.5;
        const amp = 5;

        root.style.setProperty("--px", `${(-x * amp).toFixed(2)}px`);
        root.style.setProperty("--py", `${(-y * amp).toFixed(2)}px`);
      };

      const updateScroll = () => {
        scrollRaf = 0;

        if (!active || reduceMotion) {
          resetScroll();
          return;
        }

        const rect = frame.getBoundingClientRect();
        const viewport = window.innerHeight || 1;
        const progress = clamp01((viewport - rect.top) / (viewport + rect.height));
        const subtle = clamp01(progress * 1.15);

        root.style.setProperty("--scroll", subtle.toFixed(3));
        root.style.setProperty("--scroll-y", `${(subtle * 2.6).toFixed(2)}px`);
      };

      const onScroll = () => {
        if (!active || scrollRaf) return;
        scrollRaf = requestAnimationFrame(updateScroll);
      };

      frame.addEventListener(
        "pointermove",
        (e) => {
          if (!active || reduceMotion) return;
          applyParallax(e.clientX, e.clientY);
        },
        { passive: true }
      );

      frame.addEventListener(
        "pointerleave",
        () => {
          if (reduceMotion) return;
          resetParallax();
        },
        { passive: true }
      );

      const io = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          active = Boolean(entry && entry.isIntersecting);

          if (!active) {
            resetParallax();
            resetScroll();
            return;
          }

          onScroll();
        },
        { threshold: 0.2 }
      );

      io.observe(frame);
      window.addEventListener("scroll", onScroll, { passive: true });

      setOpacities(current);
      setValueText(current);
      onScroll();
    });
  })();
</script>