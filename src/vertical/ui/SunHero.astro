---
type Props = {
  morningImage?: string;
  bluehourImage?: string;
  sunsetImage?: string;
  mobileImage?: string;

  alt?: string;

  sliderLabel?: string;
  morningLabel?: string;
  bluehourLabel?: string;
  sunsetLabel?: string;
};

const {
  morningImage = "",
  bluehourImage = "",
  sunsetImage = "",
  mobileImage = "",

  alt = "",

  sliderLabel = "Sun position",
  morningLabel = "Morning",
  bluehourLabel = "Blue hour",
  sunsetLabel = "Sunset",
} = Astro.props as Props;

const pick = (...xs: string[]) => xs.map((s) => String(s ?? "").trim()).find(Boolean) || "";

const poster = pick(morningImage, bluehourImage, sunsetImage);
const hasPoster = Boolean(poster);

const hasSunset =
  Boolean(String(sunsetImage ?? "").trim()) && String(sunsetImage ?? "").trim() !== poster;

const hasBluehour =
  Boolean(String(bluehourImage ?? "").trim()) &&
  String(bluehourImage ?? "").trim() !== poster &&
  String(bluehourImage ?? "").trim() !== String(sunsetImage ?? "").trim();
---

{hasPoster && (
  <div
    class="space-y-3"
    data-sun-hero
    data-has-bluehour={hasBluehour ? "true" : "false"}
    style="--sun:0; --bluehour-opacity:0; --sunset-opacity:0;"
  >
    <div class="sun-hero-frame relative overflow-hidden rounded-2xl border bg-slate-100">
      <picture>
        {(mobileImage && mobileImage.trim()) ? (
          <source media="(max-width: 640px)" srcset={mobileImage} />
        ) : null}
        <img
          src={poster}
          alt={alt}
          class="h-full w-full object-cover"
          loading="eager"
          decoding="async"
          width="1600"
          height="900"
        />
      </picture>

      {hasBluehour && (
        <img
          src={bluehourImage}
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 h-full w-full object-cover"
          style="opacity: var(--bluehour-opacity);"
          loading="lazy"
          decoding="async"
          width="1600"
          height="900"
        />
      )}

      {hasSunset && (
        <img
          src={sunsetImage}
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 h-full w-full object-cover"
          style="opacity: var(--sunset-opacity);"
          loading="lazy"
          decoding="async"
          width="1600"
          height="900"
        />
      )}
    </div>

    <div
      class="hidden items-center gap-2 rounded-xl border bg-white/90 px-3 py-2 text-xs sm:gap-3 sm:px-4 sm:text-sm"
      data-sun-slider-wrap
    >
      <span class="shrink-0 opacity-70" data-morning-label>{morningLabel}</span>

      <input
        type="range"
        min="0"
        max="1"
        step="0.01"
        value="0"
        aria-label={sliderLabel}
        class="h-2 w-full cursor-pointer accent-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black/60"
        data-sun-slider
      />

      <span class="shrink-0 opacity-70" data-sunset-label>{sunsetLabel}</span>

      {hasBluehour && <span class="sr-only" data-bluehour-label>{bluehourLabel}</span>}
    </div>
  </div>
)}

<style>
  .sun-hero-frame::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 52%, rgba(15, 23, 42, 0.18) 100%);
    z-index: 10;
  }
  .sun-hero-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.05;
    background-image: radial-gradient(rgba(255, 255, 255, 0.45) 0.45px, transparent 0.55px);
    background-size: 2.5px 2.5px;
    z-index: 11;
  }
</style>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll("[data-sun-hero]");
    roots.forEach((root) => {
      const wrap = root.querySelector("[data-sun-slider-wrap]");
      const slider = root.querySelector("[data-sun-slider]");
      if (!wrap || !slider) return;

      // show slider only when JS runs (no-JS remains poster-only)
      wrap.classList.remove("hidden");

      const hasBluehour = root.getAttribute("data-has-bluehour") === "true";

      const clamp01 = (v) => Math.max(0, Math.min(1, v));
      const lerp = (a, b, t) => a + (b - a) * t;

      let target = clamp01(Number(slider.value || 0));
      let current = target;
      let raf = 0;

      const setOpacities = (x) => {
        const v = clamp01(x);
        root.style.setProperty("--sun", String(v));

        if (hasBluehour) {
          let b = 0, s = 0;
          if (v <= 0.5) {
            b = v / 0.5;     // 0..1
            s = 0;
          } else {
            b = 1 - (v - 0.5) / 0.5; // 1..0
            s = (v - 0.5) / 0.5;     // 0..1
          }
          root.style.setProperty("--bluehour-opacity", String(b));
          root.style.setProperty("--sunset-opacity", String(s));
        } else {
          root.style.setProperty("--sunset-opacity", String(v));
        }
      };

      setOpacities(current);

      const tick = () => {
        current = lerp(current, target, 0.12);
        if (Math.abs(current - target) < 0.001) {
          current = target;
          setOpacities(current);
          raf = 0;
          return;
        }
        setOpacities(current);
        raf = requestAnimationFrame(tick);
      };

      slider.addEventListener("input", () => {
        target = clamp01(Number(slider.value));
        if (!raf) raf = requestAnimationFrame(tick);
      });
    });
  })();
</script>