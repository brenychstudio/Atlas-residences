---
import { type Lang, isLang, t } from "../../content/languages";

const { lang, pathname = "/" } = Astro.props as { lang?: string; pathname?: string };

const langParam = lang ?? "en";
if (!isLang(langParam)) throw new Error("Invalid lang");
const L = langParam as Lang;

const nav = [
  { href: `/${L}/`, label: t(L, "Home", "Inicio") },
  { href: `/${L}/masterplan/`, label: t(L, "Masterplan", "Plan maestro") },
  { href: `/${L}/units/`, label: t(L, "Units", "Unidades") },
  { href: `/${L}/location/`, label: t(L, "Location", "Ubicación") },
  { href: `/${L}/downloads/`, label: t(L, "Downloads", "Descargas") },
  { href: `/${L}/contact/`, label: t(L, "Contact", "Contacto") },
];

const pathLang = Astro.url.pathname.match(/^\/(en|es)(?=\/|$)/)?.[1] as Lang | undefined;

function pathForLang(nextLang: Lang) {
  return Astro.url.pathname.replace(/^\/(en|es)(?=\/|$)/, `/${nextLang}`);
}

function isActive(href: string) {
  if (href === `/${L}/`) return pathname === href;
  return pathname.startsWith(href);
}
---

<header
  data-dev-header
  class="sticky top-0 z-50 border-b border-[color:color-mix(in_oklab,var(--border),var(--fg)_14%)] bg-[color:var(--surface)]/90 backdrop-blur-md"
>
  <div class="mx-auto flex w-full max-w-[72rem] items-center justify-between gap-4 px-4 py-3 md:px-6">
    <a
      href={`/${L}/`}
      class="inline-flex min-h-[44px] items-center text-xs uppercase tracking-[0.18em] text-[color:var(--fg)]"
    >
      Atlas Residences
    </a>

    <nav class="hidden items-center gap-2 md:flex">
      {nav.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`inline-flex min-h-[42px] items-center rounded-[var(--radius-pill)] border px-4 text-sm transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--fg)]/25 ${
              active
                ? "border-[color:var(--fg)] bg-[color:var(--fg)] text-[color:var(--bg)]"
                : "border-[color:color-mix(in_oklab,var(--border),var(--fg)_12%)] bg-[color:var(--surface-2)] text-[color:var(--muted)] hover:border-[color:var(--fg)]/35 hover:bg-white hover:text-[color:var(--fg)]"
            }`}
            aria-current={active ? "page" : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-3">
      <nav
        class="inline-flex min-h-[44px] items-center rounded-[var(--radius-pill)] border border-[color:color-mix(in_oklab,var(--border),var(--fg)_14%)] bg-[color:var(--surface-2)] p-1"
        aria-label="Switch language"
        data-lang-switcher
      >
        <a
          href={pathForLang("en")}
          data-lang="en"
          class={`inline-flex min-h-[34px] items-center rounded-[var(--radius-pill)] border px-3 text-xs font-medium transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--fg)]/25 ${
            pathLang === "en"
              ? "border-[color:var(--fg)] bg-[color:var(--fg)] text-[color:var(--bg)]"
              : "border-transparent text-[color:var(--muted)] hover:border-[color:var(--fg)]/20 hover:text-[color:var(--fg)]"
          }`}
          aria-current={pathLang === "en" ? "page" : undefined}
        >
          EN
        </a>
        <a
          href={pathForLang("es")}
          data-lang="es"
          class={`inline-flex min-h-[34px] items-center rounded-[var(--radius-pill)] border px-3 text-xs font-medium transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--fg)]/25 ${
            pathLang === "es"
              ? "border-[color:var(--fg)] bg-[color:var(--fg)] text-[color:var(--bg)]"
              : "border-transparent text-[color:var(--muted)] hover:border-[color:var(--fg)]/20 hover:text-[color:var(--fg)]"
          }`}
          aria-current={pathLang === "es" ? "page" : undefined}
        >
          ES
        </a>
      </nav>

      <a
        href={`/${L}/contact/`}
        class="inline-flex min-h-[44px] items-center rounded-[var(--radius-pill)] border border-[color:color-mix(in_oklab,var(--border),var(--fg)_14%)] bg-[color:var(--surface-2)] px-4 text-sm text-[color:var(--fg)] transition-colors duration-200 hover:border-[color:var(--fg)]/40 hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--fg)]/25"
      >
        {t(L, "Book a viewing", "Reservar visita")}
      </a>
    </div>
  </div>

  <nav class="mx-auto flex w-full max-w-[72rem] items-center gap-2 overflow-x-auto px-4 pb-3 md:hidden">
    {nav.map((item) => {
      const active = isActive(item.href);
      return (
        <a
          href={item.href}
          class={`inline-flex min-h-[42px] shrink-0 items-center rounded-[var(--radius-pill)] border px-4 text-sm transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--fg)]/25 ${
            active
              ? "border-[color:var(--fg)] bg-[color:var(--fg)] text-[color:var(--bg)]"
              : "border-[color:color-mix(in_oklab,var(--border),var(--fg)_12%)] bg-[color:var(--surface-2)] text-[color:var(--muted)]"
          }`}
          aria-current={active ? "page" : undefined}
        >
          {item.label}
        </a>
      );
    })}
  </nav>
</header>

<script>
  const switcher = document.querySelector("[data-lang-switcher]");

  if (switcher) {
    const match = window.location.pathname.match(/^\/(en|es)(?=\/|$)/);
    const currentLang = match?.[1] ?? "en";

    switcher.querySelectorAll("a[data-lang]").forEach((link) => {
      const nextLang = link.getAttribute("data-lang");
      if (!nextLang) return;

      const nextPath = window.location.pathname.replace(/^\/(en|es)(?=\/|$)/, `/${nextLang}`);
      link.setAttribute("href", `${nextPath}${window.location.search}`);
      if (currentLang === nextLang) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
  }
</script>
