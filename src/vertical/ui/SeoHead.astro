---
import type { Lang } from "../../content/languages";
import { ATLAS_OG_IMAGE_URL, ATLAS_SITE_NAME, getAtlasPageSeo, type AtlasSeoPage } from "../content/seo";

type Props = {
  lang: Lang;
  page: AtlasSeoPage;
  description?: string;
  noindex?: boolean;
};

const { lang, page, description, noindex = false } = Astro.props as Props;
const seo = getAtlasPageSeo(page, lang, description);
const ogLocale = lang === "es" ? "es_ES" : "en_US";
---

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={seo.canonical} />
<link rel="alternate" hreflang="en" href={seo.alternates.en} />
<link rel="alternate" hreflang="es" href={seo.alternates.es} />
<link rel="alternate" hreflang="x-default" href={seo.alternates.xDefault} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={ATLAS_SITE_NAME} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={ATLAS_OG_IMAGE_URL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocale} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={ATLAS_OG_IMAGE_URL} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#111111" />
{noindex && <meta name="robots" content="noindex,nofollow" />}
